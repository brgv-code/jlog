---
import DesignSystem from '../components/DesignSystem';
import Layout from '../layouts/Layout.astro';

/*
 * The design system, as a page rather than a document.
 *
 * Deliberately not in the sidebar: this is a reference for whoever is building
 * jlog — a person, or a model being pointed at it — not a destination for
 * someone tracking job applications. It is public rather than behind the login
 * because the whole point is that the design can be read and copied, and jlog
 * is open source; there is nothing here that is not already in the stylesheet
 * anyone can view.
 *
 * `client:only` rather than `client:load`: this page renders by reading its own
 * computed styles, which do not exist on the server. Server-rendering it
 * produced a full catalogue of em-dashes that the first client render then
 * replaced — a hydration mismatch across every token on the page, and a visible
 * flash of placeholder content. There is nothing here worth server-rendering.
 */
---

<Layout title="Design system — jlog">
  <DesignSystem client:only="react" />
</Layout>
