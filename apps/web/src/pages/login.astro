---
import LoginPanel from '../components/LoginPanel';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sign in — jlog">
  <main
    style="
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-6);
    "
  >
    <!--
      An island rather than static markup: which sign-in methods exist is the
      server's answer, not the build's, so the card has to ask at runtime.
    -->
    <LoginPanel client:load />
  </main>
</Layout>
