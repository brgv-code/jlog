    color: var(--color-text-primary);
  }

  /* ---------- buttons ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    padding: 7px 16px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  /* The one loud thing on the page. */
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border: 1px solid var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
  }

  .btn-ghost:hover {
    background: var(--color-surface-hover);
  }

  .btn-lg {
    padding: 11px 22px;
    font-size: var(--text-base);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .headline {
    font-size: var(--text-5xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    /*
     * No ch cap. The <br> sets the break, and a measure narrow enough to be
     * useful for prose re-wrapped a two-line headline into four. The clamp on
     * --text-5xl is what keeps it in bounds at small widths instead.
     */
    text-wrap: balance;
  }

  .subheading {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .cta-row {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---------- the slanted stack ---------- */

  /*
   * The hero visual.
   *
   * Four layers at different translateZ inside one perspective. Parallax is not
   * simulated — rotating .stack rotates genuinely separated planes, so the
   * layers slide past each other at rates set by their Z, the way they would if
   * they were really at different distances.
   *
   * Depth of field is doing most of the work that "3D" usually gets credit for:
   * the far layer is blurred and desaturated, the near one is sharp. Without it
   * four sharp panels read as four stickers on glass.
   */
  .stage {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    /* The highlight a panel edge catches from the notional light above-left.
       Near-white on paper; on a dark ground that same value reads as a drawn
       white line rather than as a lit edge, so it drops to a sixth of it. */
    --edge-light: color-mix(in srgb, #fff 70%, transparent);
    position: relative;
    width: 100vw;
    /* Break the section's measure. The composition wants to run past the text
       column and bleed off both edges, so it reads as a window onto something
       larger rather than as a picture pasted into the page. */
    margin-left: calc(50% - 50vw);
    margin-top: var(--space-10);
    margin-bottom: calc(var(--space-16) * -1);
    height: 660px;
    perspective: 2000px;
    perspective-origin: 52% 42%;
    overflow: hidden;
    /* The hero centres its copy; the panels are interface and documents, which
       are set left. Without this every row label and CV bullet inherits the
       centring and the whole stack stops looking like software. */
    text-align: left;
  }

  .glow {
    position: absolute;
    inset: 6% 18% 10%;
    background:
      radial-gradient(
        ellipse 55% 60% at 42% 45%,
        color-mix(in srgb, var(--color-accent) 22%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 40% 50% at 68% 62%,
        color-mix(in srgb, var(--color-cite-cv) 18%, transparent) 0%,
        transparent 72%
      );
    filter: blur(60px);
    pointer-events: none;
  }

  .stack {
    position: absolute;
    /* Sized and centred as a fixed 1240px composition so the layout does not
       reflow with the viewport — it scales, which keeps the geometry honest. */
    width: 1240px;
    height: 660px;
    left: 50%;
    top: 0;
    margin-left: -620px;
    transform-style: preserve-3d;
    /*
     * Rotation is scaled by --p, the hero's progress out of the viewport, so
     * the stack settles toward square-on as it rises. That is the whole trick:
     * a tilt that never changes is a render, a tilt that resolves as you move
     * is an object you are walking around.
     */
    transform: rotateX(calc((9deg + var(--tilt-x)) * (1 - var(--p, 0) * 0.72)))
      rotateY(calc((-15deg + var(--tilt-y)) * (1 - var(--p, 0) * 0.72)));
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /*
   * --z  how far forward this layer sits, which sets how fast it slides when
   *      the stack rotates. Real separation, not a simulated offset.
   * --par how much it drifts vertically with scroll. Nearer layers travel
   *      further, which is the same rule a camera obeys.
   */
  .layer {
    --z: 0px;
    --par: 0;
    position: absolute;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transform-style: preserve-3d;
    /* A light source at upper-left: a hairline highlight on the top edge and a
       long shadow below. Two lines, and it is most of what makes a flat panel
       look like a physical one. */
    box-shadow:
      inset 0 1px 0 var(--edge-light),
      var(--shadow-lg);
    animation: float 9s ease-in-out infinite;
    /* Separation collapses as the hero leaves, so the stack gathers itself on
       the way out instead of simply scrolling off still exploded. */
    transform: translateZ(calc(var(--z) * (1 - var(--p, 0) * 0.5)))
      translateY(calc(var(--p, 0) * var(--par) * -130px));
    /* The same easing the stack's rotation uses. Both are driven by --p, and a
       container that eases while its children snap reads as two objects. */
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Staggered so the four never bob in unison, which is what makes float
     animations look mechanical. */
  .layer-jd {
    width: 430px;
    left: 40px;
    top: 26px;
    --z: -190px;
    --par: -0.3;
    opacity: 0.82;
    filter: blur(1.4px) saturate(0.82);
    animation-duration: 11s;
  }

  .layer-list {
    width: 620px;
    left: 258px;
    top: 148px;
    --z: -30px;
    --par: 0.08;
    filter: blur(0.35px);
    animation-duration: 9.5s;
    animation-delay: -2.4s;
  }

  .layer-cv {
    width: 400px;
    left: 706px;
    top: 276px;
    --z: 140px;
    --par: 0.42;
    background: var(--color-paper);
    animation-duration: 8.5s;
    animation-delay: -5.1s;
  }

  /*
   * Last in the sequence, so it sits at the end of it: over the CV's lower
   * right, clear of the cited bullets, which is the one part of that panel
   * worth reading. It used to sit top-right, where the capture card now is.
   */
  .layer-chip {
    width: 214px;
    left: 1040px;
    top: 505px;
    --z: 250px;
    --par: 0.7;
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--color-surface);
    animation-duration: 7s;
    animation-delay: -1.2s;
  }

  /* `translate` is its own property, so this composes with the transform above
     instead of fighting it. */
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -13px;
    }
  }

  /* ---- window chrome / panel bars ---- */

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 9px var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    font-size: 11px;
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }

  .bar-url {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    font-size: 10px;
  }

  .bar-title {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    font-size: 10px;
  }

  .bar-tools {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: var(--space-2);
  }

  .tab {
    padding: 3px 8px;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 10px;
  }

  .tab.on {
    background: var(--color-surface-active);
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .search {
    margin-left: var(--space-2);
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-tertiary);
    font-size: 10px;
    white-space: nowrap;
  }

  .bar-count {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    font-size: 10px;
  }

  /* ---- the posting ---- */

  .jd {
    padding: var(--space-4);
  }

  .jd-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .jd-meta {
    margin-top: 2px;
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .jd-p {
    margin-top: var(--space-3);
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .jd-h {
    margin-top: var(--space-4);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .jd-list {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .jd-list li {
    font-size: 11px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* The requirement the generated bullet on the front layer answers. */
  .jd-hit {
    list-style: none;
    margin-left: calc(var(--space-4) * -1);
    padding: 3px var(--space-2) 3px var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-cite-jd-fill);
    box-shadow: inset 2px 0 0 var(--color-cite-jd);
    color: var(--color-text-primary);
  }

  /* ---- the pipeline ---- */

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 9px var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row-on {
    background: var(--color-surface-raised);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  /* The same hashed-hue monogram the real list draws when an employer has no
     cached logo, which is most of them. */
  .mono-tile {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    background-color: hsl(var(--h) 46% 91%);
    color: hsl(var(--h) 42% 32%);
  }

  /* Mirrors [data-theme="dark"] .jlog-monogram in tokens.css. Without it the
     hero keeps light tiles while the real list below it flips, and the two are
     on screen within one scroll of each other. */
  :global([data-theme='dark']) .mono-tile {
    background-color: hsl(var(--h) 24% 17%);
    color: hsl(var(--h) 46% 72%);
  }

  :global([data-theme='dark']) .stage {
    --edge-light: color-mix(in srgb, #fff 11%, transparent);
  }

  .mono-tile[data-h='14'] {
    --h: 14;
  }
  .mono-tile[data-h='28'] {
    --h: 28;
  }
  .mono-tile[data-h='120'] {
    --h: 120;
  }
  .mono-tile[data-h='196'] {
    --h: 196;
  }
  .mono-tile[data-h='252'] {
    --h: 252;
  }
  .mono-tile[data-h='320'] {
    --h: 320;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .co {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ro {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .meta {
    font-size: 10px;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .pill {
    display: inline-block;
    padding: 2px 9px;
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
    flex: none;
    width: 78px;
    text-align: center;
  }

  .pill.saved {
    color: var(--color-status-saved);
    background: color-mix(in srgb, var(--color-status-saved) 12%, transparent);
  }

  .pill.applied {
    color: var(--color-status-applied);
    background: color-mix(in srgb, var(--color-status-applied) 12%, transparent);
  }

  .pill.interviewing {
    color: var(--color-status-interviewing);
    background: color-mix(in srgb, var(--color-status-interviewing) 12%, transparent);
  }

  .pill.offer {
    color: var(--color-status-offer);
    background: color-mix(in srgb, var(--color-status-offer) 12%, transparent);
  }

  /* ---- the document ---- */

  .cv {
    padding: var(--space-5) var(--space-5) var(--space-3);
    color: var(--color-paper-ink);
  }

  .cv-head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper-ink) 18%, transparent);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cv-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cv-contact {
    font-size: 9.5px;
    color: color-mix(in srgb, var(--color-paper-ink) 58%, transparent);
  }

  .cv-sec {
    margin-top: var(--space-4);
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-paper-ink) 62%, transparent);
  }

  /* moderncv's hint column: dates left, entry right. */
  .cv-entry {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: var(--space-3);
  }

  .cv-when {
    font-size: 9.5px;
    text-align: right;
    padding-top: 1px;
    color: color-mix(in srgb, var(--color-paper-ink) 55%, transparent);
  }

  .cv-what {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cv-role {
    font-size: 11px;
    font-weight: 600;
  }

  .cv-b {
    font-size: 10.5px;
    line-height: 1.55;
  }

  .cite {
    background: none;
    color: inherit;
    padding-bottom: 1px;
  }

  .cite-cv {
    box-shadow: inset 0 -2px 0 var(--color-cite-cv);
    background: var(--color-cite-cv-fill);
  }

  .cite-jd {
    box-shadow: inset 0 -2px 0 var(--color-cite-jd);
    background: var(--color-cite-jd-fill);
  }

  .cv-key {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-5) var(--space-3);
    font-size: 9.5px;
    color: color-mix(in srgb, var(--color-paper-ink) 58%, transparent);
  }

  .cv-key span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sw {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .sw-cv {
    background: var(--color-cite-cv);
  }

  .sw-jd {
    background: var(--color-cite-jd);
  }

  /* ---- the compile chip ---- */

  .chip-main {
    font-size: 11px;
    font-weight: 500;
  }

  .chip-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-text-tertiary);
  }

  /* The one genuinely live element. A status light that has just gone green
     says the thing finished; four still panels cannot. */
  .ping {
    position: absolute;
    top: 13px;
    right: 13px;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--color-status-offer);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-status-offer) 60%, transparent);
    animation: ping 2.6s ease-out infinite;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-status-offer) 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  /* ---- the comet ---- */

  .comet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: visible;
  }

  .comet rect {
    animation: comet 4.5s linear infinite;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-accent) 70%, transparent));
  }

  @keyframes comet {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /*
   * Everything above is ornament. Under prefers-reduced-motion the composition
   * stays exactly as it is and simply stops moving — the layout is the content,
   * the animation is not.
   */
  @media (prefers-reduced-motion: reduce) {
    .layer,
    .comet rect,
    .ping {
      animation: none;
    }
  }


  /* ---------- the extension, mid-capture ---------- */

  /*
   * Nearest to the viewer and highest in the frame, but not so high that
   * perspective magnification pushes its head through the top of the stage —
   * a z of 300 lifts a panel roughly 130px before it is drawn, which is what
   * was cropping the card's own title off.
   */
  .layer-ext {
    width: 268px;
    left: 890px;
    top: 172px;
    --z: 280px;
    --par: 0.86;
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4) var(--space-4);
    animation-duration: 10.5s;
    animation-delay: -3.6s;
  }

  .ext-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .ext-mark {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-size: 11px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ext-title {
    font-size: 11px;
    font-weight: 600;
  }

  .ext-fields {
    padding: var(--space-3) 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .ext-fields div {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .ext-fields dt {
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .ext-fields dd {
    font-size: 11px;
    font-weight: 500;
  }

  .ext-cta {
    display: block;
    text-align: center;
    padding: 6px;
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-primary-fg);
    font-size: 11px;
    font-weight: 500;
  }

  /* ---------- proof band ---------- */

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .proof-grid dt {
    /* Tabular figures: without them the box reflows on every frame of the
       count-up as digit widths change, and the label under it twitches. */
    font-variant-numeric: tabular-nums;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .proof-grid dd {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /*
   * The board list as a ticker.
   *
   * Three identical sets, the track travelling exactly one of them before it
   * loops, so the wrap is invisible — and masked at both ends so it reads as a
   * strip passing through the page rather than a row that starts and stops at
   * the margins.
   *
   * Full-bleed and set large on purpose. At pill size one set was 510px inside
   * a 1080px column, so both copies stood on screen at once and the thing read
   * as the list printed twice rather than as a loop. A ticker only works when
   * one set is wider than its window.
   */
  .marquee {
    margin-top: var(--space-12);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 34s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding-right: var(--space-12);
  }

  @keyframes marquee {
    to {
      /* One copy of three. */
      transform: translateX(-33.3333%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .board {
    display: inline-flex;
    align-items: center;
    gap: var(--space-12);
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    letter-spacing: -0.01em;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  /* The separator belongs to the item, not to the gap, so the last board of one
     set is spaced from the first of the next exactly like every other pair and
     the seam stays invisible. */
  .board::after {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-border);
  }

  /* ---------- steps ---------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .step {
    padding: 0 var(--space-6);
  }

  .step:first-child {
    padding-left: 0;
  }

  .step + .step {
    border-left: 1px solid var(--color-border);
  }

  .step-icon {
    width: 22px;
    height: 22px;
    display: block;
    margin-bottom: var(--space-4);
  }

  /* The sidebar's per-destination hues, reused so the page and the app agree. */
  .step-icon-capture {
    color: var(--color-icon-applications);
  }

  .step-icon-track {
    color: var(--color-icon-home);
  }

  .step-icon-tailor {
    color: var(--color-icon-cv);
  }

  .step-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .step-body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* ---------- grounding ---------- */

  .grounding {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .grounding-facts {
    list-style: none;
  }

  .grounding-facts li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .grounding-facts li:first-child {
    padding-top: 0;
  }

  .grounding-facts li:last-child {
    border-bottom: none;
  }

  .fact-k {
    color: var(--color-text-tertiary);
  }

  .fact-v {
    color: var(--color-text-primary);
  }

  /* ---------- templates ---------- */

  .template-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .template {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /*
   * Each sheet is a diagram of one design's skeleton. The differences that
   * matter when picking are where the name sits and whether there is a hint
   * column beside the body — moderncv's classic and casual carry one, the rest
   * run full width — so those are the only things drawn. Anything more detailed
   * would be inventing output the compiler has not produced.
   */
  .sheet {
    aspect-ratio: 1 / 1.414;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 11%;
    display: flex;
    flex-direction: column;
    gap: 8%;
    overflow: hidden;
  }

  .sheet-head {
    display: block;
    flex: none;
  }

  .sheet-name {
    display: block;
    height: 7px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-paper-ink) 34%, transparent);
  }

  .sheet-main {
    display: flex;
    flex: 1;
    gap: 8%;
    min-height: 0;
  }

  .sheet-hint,
  .sheet-body {
    display: block;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 7px
    );
  }

  .sheet-body {
    flex: 1;
  }

  /* The narrow dates/keywords column moderncv puts left of the entries. */
  .sheet-hint {
    width: 27%;
    flex: none;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 21px
    );
  }

  .sheet-classic .sheet-name {
    width: 54%;
  }

  .sheet-banking .sheet-head {
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-paper-ink) 28%, transparent);
    padding-bottom: 7%;
  }

  .sheet-banking .sheet-name {
    width: 62%;
    margin: 0 auto;
  }

  .sheet-casual .sheet-name {
    width: 46%;
    height: 12px;
  }

  .sheet-oldstyle .sheet-name {
    width: 50%;
    margin: 0 auto;
  }

  .sheet-oldstyle .sheet-body {
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 10px
    );
  }

  .sheet-fancy .sheet-head {
    background: color-mix(in srgb, var(--color-paper-ink) 20%, transparent);
    padding: 5% 6%;
    border-radius: 1px;
  }

  .sheet-fancy .sheet-name {
    width: 58%;
    height: 6px;
    background: color-mix(in srgb, var(--color-paper-ink) 45%, transparent);
  }

  .sheet-plain .sheet-name {
    width: 36%;
    height: 5px;
    background: color-mix(in srgb, var(--color-paper-ink) 26%, transparent);
  }

  .sheet-plain .sheet-body {
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 5px
    );
  }

  .template-label {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* ---------- open source ---------- */

  .oss-actions {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .oss-note {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    max-width: 40ch;
    line-height: 1.5;
  }

  /* ---------- closer ---------- */

  .closer {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .closer-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  /* ---------- footer ---------- */

  .footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .footer-sep {
    width: 1px;
    height: 12px;
    background: var(--color-border-strong);
  }

  .footer-link {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }


  /* ---------- capture ---------- */

  .tiers {
    list-style: none;
  }

  .tier {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .tier:first-child {
    padding-top: 0;
  }

  .tier:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .tier-n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .tier-t {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .tier-b {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* The honest half of "automatic": what each tier actually costs you. */
  .tier-cost {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  /* ---------- home ---------- */

  /*
   * One panel, drawn rather than screenshotted: it themes with the page, stays
   * sharp at any zoom, and cannot go stale the way an exported PNG of a chart
   * does the first time the real chart changes.
   */
  /* Not `.board` — that name already belongs to a job board in the ticker
     above, and inheriting its inline-flex mono display turned this panel into
     one very wide line. */
  .home-panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    overflow: hidden;
  }

  .attention {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--color-border);
  }

  .att {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-6);
  }

  .att + .att {
    border-left: 1px solid var(--color-border);
  }

  .att-k {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .att-v {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .att-h {
    font-size: 11px;
    line-height: 1.45;
    color: var(--color-text-tertiary);
  }

  /*
   * Trend across the top, then the three comparisons in one row. At two
   * columns the fourth chart sat alone on a third row with half the panel
   * empty beside it, which reads as a chart that failed to load.
   */
  .charts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .chart {
    padding: var(--space-5) var(--space-6) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* Every chart in the bottom row except the first gets the divider; the first
     follows the full-width trend, where a left border would run into nothing. */
  .chart:not(.chart-wide) + .chart {
    border-left: 1px solid var(--color-border);
  }

  /* The trend spans both columns: it is the only chart whose shape, rather
     than whose values, is the thing being read. */
  .chart-wide {
    grid-column: 1 / -1;
    border-top: none;
  }

  .chart figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .chart figcaption span {
    font-weight: 400;
    color: var(--color-text-tertiary);
  }

  .trend {
    display: block;
    width: 100%;
    height: 96px;
  }

  /* The one chart carrying the accent (DESIGN.md). Everything else is ink. */
  .trend-line {
    fill: none;
    stroke: var(--color-chart-mark);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .trend-area {
    fill: color-mix(in srgb, var(--color-chart-mark) 10%, transparent);
    stroke: none;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-tertiary);
  }

  .bars {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .bars li {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 20px;
    align-items: center;
    gap: var(--space-2);
    font-size: 11px;
  }

  .bar-k {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* Status rides a dot beside the label, never the bar fill: offer and rejected
     are 4.2 ΔE apart under deuteranopia, which is fine on a labelled pill and
     misleading when bar length is the comparison. */
  .dot::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: var(--radius-full);
    background: var(--tone);
    vertical-align: middle;
  }

  .dot-saved {
    --tone: var(--color-status-saved);
  }
  .dot-applied {
    --tone: var(--color-status-applied);
  }
  .dot-interviewing {
    --tone: var(--color-status-interviewing);
  }
  .dot-offer {
    --tone: var(--color-status-offer);
  }
  .dot-rejected {
    --tone: var(--color-status-rejected);
  }
  .dot-withdrawn {
    --tone: var(--color-status-withdrawn);
  }

  .bar-track {
    height: 8px;
    background: var(--color-chart-grid);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  /* Square at the baseline, rounded at the data end — the spec the real charts
     follow, so a rounded start never reads as a value it does not hold. */
  .bar-fill {
    display: block;
    height: 100%;
    min-width: 3px;
    background: var(--color-chart-bar);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .bar-v {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-tertiary);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .cols {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: end;
    gap: var(--space-3);
    height: 116px;
  }

  .cols li {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    gap: var(--space-2);
    height: 100%;
  }

  /* 24px is the spec's ceiling for bar thickness, and a histogram column
     stretched to a third of a panel stops reading as a measurement. */
  .col {
    display: block;
    width: 100%;
    max-width: 24px;
    margin: 0 auto;
    background: var(--color-chart-bar);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    min-height: 3px;
  }

  .col-k {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-tertiary);
    text-align: center;
  }

  /* ---------- one application ---------- */

  .detail-rail {
    list-style: none;
    margin-top: var(--space-8);
  }

  .detail-rail li {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .detail-rail span {
    color: var(--color-text-tertiary);
  }

  .ba {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ba-pane {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .ba-pane figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .ba-tag {
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-surface-active);
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .ba-tag-on {
    background: var(--color-primary);
    color: var(--color-primary-fg);
  }

  /* The captured half is shown as what it is — a text file — wraps and all. */
  .ba-raw {
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.7;
    color: var(--color-text-tertiary);
    white-space: pre-wrap;
  }

  .ba-out {
    padding: var(--space-4);
  }

  .ba-h {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .ba-h + .ba-p,
  .ba-h + .ba-ul {
    margin-top: var(--space-2);
  }

  .ba-p {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .ba-p + .ba-h,
  .ba-ul + .ba-h {
    margin-top: var(--space-4);
  }

  .ba-ul {
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ba-ul li {
    font-size: 12px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    list-style: disc;
  }

  /* ---------- import ---------- */

  .review {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .review-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .review-file {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .review-count {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .review-rows {
    list-style: none;
  }

  .review-rows li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .review-rows li:last-child {
    border-bottom: none;
  }

  .tick {
    width: 16px;
    height: 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
  }

  .tick {
    position: relative;
  }

  .review-rows .on .tick {
    border-color: var(--color-primary);
    background: var(--color-primary);
  }

  /* Two borders on a rotated box, not a glyph: it keeps its stroke weight at
     any size and takes the theme's foreground with its ground. */
  .review-rows .on .tick::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 2px;
    width: 3px;
    height: 7px;
    border: solid var(--color-primary-fg);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }

  .review-t {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .review-rows li:not(.on) .review-t {
    color: var(--color-text-tertiary);
    text-decoration: line-through;
  }

  .review-kind {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-tertiary);
  }

  /* ---------- self-hosting ---------- */

  .providers {
    list-style: none;
  }

  .providers li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .prov-n {
    font-size: var(--text-base);
    font-weight: 500;
  }

  .prov-note {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-align: right;
  }

  .prov-foot {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ---------- plans ---------- */

  .plan-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    margin-top: var(--space-10);
  }

  /* A hairline between them, not two cards. Boxing a price is how a quiet page
     acquires its first advertisement. */
  .plan + .plan {
    padding-left: var(--space-12);
    border-left: 1px solid var(--color-border);
    margin-left: calc(var(--space-12) * -1);
  }

  .plan-k {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-3);
  }

  .plan-k-pro {
    color: var(--color-text-primary);
  }

  .plan-lead {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-5);
  }

  .plan-list {
    list-style: none;
  }

  .plan-list li {
    position: relative;
    padding: var(--space-2) 0 var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .plan-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 10px;
    height: 1px;
    background: var(--color-border-strong);
  }

  .plan-note {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  /* ---------- narrow ---------- */

  /*
   * The stack is a fixed 1240px composition, so it scales as one object rather
   * than reflowing — perspective children cannot be laid out by a grid, and
   * rewrapping them would break the geometry that makes the depth read.
   */
  /*
   * Height follows the scale. `scale` shrinks the stack about its centre, so a
   * 660px composition at 0.86 still occupies 568px of the stage — trim the
   * stage below that and the crop lands on the chip in the lower right, which
   * is a 65px object and reads as broken rather than as a bleed.
   */
  @media (max-width: 1280px) {
    .stage {
      height: 620px;
    }

    .stack {
      scale: 0.86;
    }

    /* Scaling pulls the composition in from the left but perspective still
       throws the nearest layer outward, so the chip alone needs walking back
       inside the frame. */
    .layer-chip {
      left: 1000px;
    }
  }

  @media (max-width: 1040px) {
    .stage {
      height: 540px;
    }

    .stack {
      scale: 0.72;
    }
  }

  @media (max-width: 900px) {
    section {
      padding: var(--space-12) var(--space-5);
    }

    .proof-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-6);
    }

    /* A ticker set wider than the window is the whole point of one, but at
       display size a 390px window holds a word and a half and the strip stops
       reading as a list at all. */
    .board {
      font-size: var(--text-xl);
      gap: var(--space-6);
    }

    .marquee-set {
      gap: var(--space-6);
      padding-right: var(--space-6);
    }

    .grounding {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .step {
      padding: var(--space-6) 0;
    }

    .step:first-child {
      padding-top: 0;
    }

    .step + .step {
      border-left: none;
      border-top: 1px solid var(--color-border);
    }

    .template-strip {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Every two-column section folds on the same rule, in the same order:
       prose first, the thing it describes under it. */
    .capture,
    .detail,
    .oss,
    .plan-split {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    /* The divider follows the fold — a left border on a stacked column draws a
       line down the side of nothing. */
    .plan + .plan {
      padding-left: 0;
      margin-left: 0;
      border-left: none;
      padding-top: var(--space-10);
      border-top: 1px solid var(--color-border);
    }

    .attention,
    .charts {
      grid-template-columns: 1fr;
    }

    .att + .att {
      border-left: none;
      border-top: 1px solid var(--color-border);
    }

    /* Matching the base rule's selector exactly, not a shorter one: a media
       query adds no specificity, so `.chart + .chart` simply lost to it. */
    .chart:not(.chart-wide) + .chart {
      border-left: none;
    }

    /* The cost column has nowhere to sit beside three lines of body text at
       this width; it drops under the title instead of squeezing it. */
    .tier {
      grid-template-columns: auto 1fr;
    }

    .tier-cost {
      grid-column: 2;
    }

    .bars li {
      grid-template-columns: 78px 1fr 22px;
    }
  }

  @media (max-width: 860px) {
    /*
     * A phone has none of the horizontal room this composition needs, and a
     * 0.4 scale would make 10px type unreadable. Straight on and stacked
     * instead — still layered, with the shadow left carrying the depth.
     *
     * The blur and the float go too: both are depth cues for a scene that no
     * longer has depth, and a blurred panel on a phone just looks broken.
     */
    .stage {
      width: 100%;
      margin-left: 0;
      margin-bottom: 0;
      height: auto;
      perspective: none;
      overflow: visible;
      margin-top: var(--space-12);
    }

    .glow {
      display: none;
    }

    .stack {
      position: static;
      width: 100%;
      height: auto;
      margin-left: 0;
      transform: none;
      scale: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .layer {
      position: static;
      width: 100%;
      transform: none;
      opacity: 1;
      filter: none;
      animation: none;
    }

    /* Nothing to run the perimeter of, once the panel is just a card in a
       column. */
    .comet,
    .layer-chip .ping {
      display: none;
    }

    .layer-chip {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
    }

    /*
     * The list panel's toolbar is a desktop toolbar: three filter tabs and a
     * 200px search field, which do not fit a phone-width card and were pushing
     * the document 90px wider than the viewport. The filters still read as
     * filters without the search box beside them.
     */
    .bar {
      flex-wrap: wrap;
    }

    .search,
    .meta {
      display: none;
    }

    .bar-count {
      margin-left: auto;
    }
  }

  @media (max-width: 560px) {
    .nav {
