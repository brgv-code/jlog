---
/*
 * The homepage.
 *
 * One idea above the fold: an application is four things (the posting, the
 * form, the record, the CV), and jlog is the layer that ties them. They are
 * drawn as an exploded stack of real UI in 3D that separates as you scroll,
 * each layer labelled by an arrow. Below it the page is a ruled grid: boards,
 * the six features, the tailored-CV trace, pricing, open source, FAQ.
 *
 * Every claim is what the product does. Companies and people are invented.
 * The FAQ and the structured data are built from one list.
 */
import SiteLayout from '../layouts/SiteLayout.astro';

/*
 * The Chrome Web Store listing. Empty until the extension is published: the
 * store assigns the URL on first upload, and a button that 404s is worse than
 * none. Set it and the install buttons appear.
 */
const STORE_URL = '';
const GITHUB_URL = 'https://github.com/brgv-code/jlog';

const BOARDS = ['LinkedIn', 'Greenhouse', 'Lever', 'Ashby', 'Wellfound', 'YC Jobs'];

/* The four layers, bottom to top, and what each arrow says about it. */
const notes = [
  { n: '01', side: 'left', title: 'Captured', body: 'from the board you applied on' },
  { n: '02', side: 'right', title: 'Filled', body: 'from your profile, never submitted' },
  { n: '03', side: 'left', title: 'Tracked', body: 'from saved to offer, in one list' },
  { n: '04', side: 'right', title: 'Tailored', body: 'a CV built from your own lines' },
];

const features = [
  {
    n: '01',
    id: 'capture',
    title: 'Capture',
    body: 'Apply on LinkedIn, Greenhouse, Lever, Ashby, Wellfound or YC and the row writes itself. Anywhere else, one click reads the page.',
  },
  {
    n: '02',
    id: 'autofill',
    title: 'Autofill',
    body: 'Fills the empty fields of an application from your profile. Never guesses visa or salary answers, and never presses submit.',
  },
  {
    n: '03',
    id: 'tailored-cv',
    title: 'Tailored CV',
    body: 'A CV for each posting, built from sentences you already wrote. Every line links back to where it came from.',
    href: '/features/tailored-cv',
  },
  {
    n: '04',
    id: 'answers',
    title: 'Drafted answers',
    body: '“Why do you want to work here?” gets a draft from your real experience, with the facts it used listed underneath.',
    pro: true,
  },
  {
    n: '05',
    id: 'tracking',
    title: 'Tracking',
    body: 'Saved to offer in one list, with notes, follow-ups and the original posting kept next to each application.',
  },
  {
    n: '06',
    id: 'home',
    title: 'Home',
    body: 'Opens on what needs you: applications gone quiet, replies you are waiting on, conversations in progress.',
  },
];

const faqs = [
  {
    q: 'Does jlog apply to jobs for me?',
    a: 'No. It records applications you make, and on Greenhouse, Lever and Ashby it fills empty fields from your profile. It never presses submit: you read the form and send it yourself.',
  },
  {
    q: 'Is the free plan really free?',
    a: 'Yes. Capture, tracking, the dashboard, form filling and CV import are free with no time limit and no card. Pro, at €9 a month, adds tailored CVs, cover letters and drafted answers.',
  },
  {
    q: 'Which job boards does it work with?',
    a: 'Applications are captured automatically on LinkedIn, Wellfound, Ashby, Greenhouse, Lever and Y Combinator’s job board. On any other page, one click reads the posting, and anything else can be added by hand.',
  },
  {
    q: 'Can the AI make up experience on my CV?',
    a: 'No. Every line is a sentence from the CV you imported or a wording you used in an earlier application. The model only chooses and orders them, and each line links back to where it came from.',
  },
  {
    q: 'Is my data sent to your server?',
    a: 'On the hosted version, yes: applications, your CV and the postings you extract are stored by jlog, and postings and CV text go to the AI provider you configured. Nothing is sold or shared with anyone else. Self-host it and nothing leaves your own Cloudflare account.',
  },
  {
    q: 'Why do I need my own AI key?',
    a: 'So you pay the provider directly, at cost, and jlog never marks it up. A whole job search usually costs under €2 in model usage. With Ollama, nothing leaves your machine.',
  },
];

/* Structured data: what the product is and what it costs, plus the FAQ. */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'jlog',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Chrome',
    description:
      'Open-source job application tracker with a Chrome extension that captures applications and builds tailored CVs from your real experience.',
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Pro', price: '9', priceCurrency: 'EUR' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<SiteLayout
  title="jlog — Job Application Tracker & Tailored CV Builder"
  description="Free, open-source job application tracker. Captures applications from LinkedIn, Greenhouse and Lever, then builds a tailored CV from your real experience."
>
  <div class="rail">
    <!-- ─────────────── Hero ─────────────── -->
    <section class="row hero">
      <a class="announce" href="#autofill">
        <span class="tag">New</span> Autofill on Greenhouse, Lever and Ashby <span aria-hidden="true">→</span>
      </a>
      <h1 class="display hero-title">
        Job applications,<br /><span class="dim">without the busywork.</span>
      </h1>
      <p class="lead hero-lead">
        jlog records every application you make, fills in the forms, and builds a tailored CV
        (résumé) from your real experience.
      </p>
      <div class="cta">
        <a href="/login" class="btn btn-ink">Get started for free</a>
        <a href="#features" class="btn btn-line">See how it works</a>
      </div>

      <!--
        The exploded stack. Four layers of real UI, bottom to top: the posting,
        the form, the record, the CV. They start almost flat and separate as the
        page scrolls; each carries an anchor the arrows are drawn to.
      -->
      <div class="stage" data-stage aria-label="How one application moves through jlog: captured, filled, tracked, tailored">
        <svg class="arrows" data-arrows aria-hidden="true">
          <defs>
            <marker id="tip" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M1 1 L8 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </marker>
          </defs>
        </svg>

        <ol class="notes notes-left">
          {
            [notes[2], notes[0]].map((note) => note && (
              <li class="note" data-note={note.n}>
                <span class="kicker-n">{note.n}</span>
                <span class="note-t">{note.title}</span>
                <span class="note-b">{note.body}</span>
              </li>
            ))
          }
        </ol>

        <div class="scene" aria-hidden="true">
          <div class="stack" data-stack>
            <!-- 01 · the posting -->
            <div class="layer frame l-post" style="--i:0">
              <p class="frame-bar">boards.greenhouse.io/fabrikam</p>
              <div class="l-body">
                <p class="l-co">Fabrikam</p>
                <p class="l-title">Senior Frontend Engineer, Payments</p>
                <p class="l-sub">Berlin or remote (EU) · Full time</p>
                <span class="bar"></span><span class="bar"></span><span class="bar bar-s"></span>
                <span class="l-apply">Apply for this job</span>
              </div>
              <span class="anchor anchor-l" data-anchor="01"></span>
            </div>

            <!-- 02 · the form, filled -->
            <div class="layer frame l-form" style="--i:1">
              <p class="frame-bar">Fabrikam · application</p>
              <div class="l-body">
                <div class="field"><span>First name</span><b>Ada</b><i>✓</i></div>
                <div class="field"><span>Email</span><b>ada.lovelace@example.com</b><i>✓</i></div>
                <div class="field"><span>Phone</span><b>+1 202 555 0142</b><i>✓</i></div>
                <div class="field"><span>Authorised to work in Germany?</span><b>Yes</b><i>✓</i></div>
                <p class="l-foot"><span class="tag">Fill with jlog</span> 9 fields filled · submit is yours</p>
              </div>
              <span class="anchor anchor-r" data-anchor="02"></span>
            </div>

            <!-- 03 · the record -->
            <div class="layer frame l-list" style="--i:2">
              <p class="frame-bar">jlog · Applications</p>
              <ul class="l-rows">
                <li class="new"><span class="t">F</span><span>Senior Frontend Engineer · Fabrikam</span><span class="pill pill-applied">Applied</span></li>
                <li><span class="t">N</span><span>Product Engineer · Northwind</span><span class="pill pill-interviewing">Interview</span></li>
                <li><span class="t">C</span><span>Staff Engineer · Contoso</span><span class="pill pill-offer">Offer</span></li>
                <li><span class="t">B</span><span>Frontend Engineer · Brightwave</span><span class="pill pill-saved">Saved</span></li>
              </ul>
              <span class="anchor anchor-l" data-anchor="03"></span>
            </div>

            <!-- 04 · the tailored CV -->
            <div class="layer sheet l-cv" style="--i:3">
              <p class="cv-name">Ada Lovelace</p>
              <p class="cv-sub">Senior Frontend Engineer · for Fabrikam</p>
              <div class="cv-line"><span>Led the move of the checkout from jQuery to React without a feature freeze.</span><span class="tag tag-signal">line 7</span></div>
              <div class="cv-line"><span>Cut p95 page load from 3.1s to 1.2s with code-splitting.</span><span class="tag tag-signal">line 8</span></div>
              <div class="cv-line"><span>Owned the component library five product teams build on.</span><span class="tag">earlier</span></div>
              <span class="anchor anchor-r" data-anchor="04"></span>
            </div>
          </div>
        </div>

        <ol class="notes notes-right">
          {
            [notes[3], notes[1]].map((note) => note && (
              <li class="note" data-note={note.n}>
                <span class="kicker-n">{note.n}</span>
                <span class="note-t">{note.title}</span>
                <span class="note-b">{note.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ─────────────── Boards ─────────────── -->
    <section class="row row-tight boards">
      <p class="meta">Captures applications on</p>
      <ul>{BOARDS.map((b) => <li>{b}</li>)}</ul>
    </section>

    <!-- ─────────────── Features ─────────────── -->
    <section class="row" id="features">
      <div class="kicker"><span class="kicker-n">∗</span><span class="meta">Product</span></div>
      <h2 class="h2">Everything between the posting<br /><span class="dim">and the offer.</span></h2>
    </section>
    <ul class="features">
      {
        features.map((f) => (
          <li class="feature" id={f.id}>
            <span class="meta feature-n">{f.n}</span>
            <h3 class="h3">
              {f.title}
              {f.pro && <span class="tag">Pro</span>}
            </h3>
            <p class="feature-body">{f.body}</p>
            {f.href ? (
              <a class="feature-link" href={f.href}>
                Explore <span aria-hidden="true">→</span>
              </a>
            ) : null}
          </li>
        ))
      }
    </ul>

    <!-- ─────────────── Tailored CV ─────────────── -->
    <section class="row trace-row">
      <div class="trace-copy">
        <div class="kicker"><span class="kicker-n">03</span><span class="meta">Tailored CV</span></div>
        <h2 class="h2">A CV that never<br /><span class="dim">invents experience.</span></h2>
        <p class="body">
          Every line on a tailored CV is a sentence from the CV you imported, or a wording you
          already sent. The model chooses and orders them. It does not write new ones.
        </p>
        <a class="btn btn-line" href="/features/tailored-cv">How it works <span aria-hidden="true">→</span></a>
      </div>
      <div class="trace" data-trace aria-hidden="true">
        <svg class="trace-wires" data-trace-wires></svg>
        <div class="trace-col">
          <p class="meta">Your CV</p>
          <p class="trace-item" data-t="a">07 · Led the move of the checkout from jQuery to React.</p>
          <p class="trace-item" data-t="b">08 · Cut p95 page load from 3.1s to 1.2s.</p>
          <p class="trace-item muted">10 · Mentored three junior engineers.</p>
        </div>
        <div class="trace-col">
          <p class="meta">For Fabrikam</p>
          <p class="trace-item out" data-t="a2">Led the move of the checkout from jQuery to React.</p>
          <p class="trace-item out" data-t="b2">Cut p95 page load from 3.1s to 1.2s.</p>
          <p class="trace-item gap">Not asked for: left out.</p>
        </div>
      </div>
    </section>

    <!-- ─────────────── Pricing ─────────────── -->
    <section class="row" id="pricing">
      <div class="kicker"><span class="kicker-n">€</span><span class="meta">Pricing</span></div>
      <h2 class="h2">Tracking is free,<br /><span class="dim">and stays free.</span></h2>
    </section>
    <div class="plans">
      <article class="plan">
        <p class="meta">Free</p>
        <p class="plan-price">€0</p>
        <p class="plan-lead">Everything that runs a search.</p>
        <ul>
          <li>Automatic capture on six job boards</li>
          <li>Application forms filled, never submitted</li>
          <li>Unlimited applications, notes and follow-ups</li>
          <li>Home, and every chart behind it</li>
          <li>CV import, and the facts it reads out</li>
          <li>Self-host it on your own Cloudflare account</li>
        </ul>
        <a class="btn btn-line" href="/login">Start for free</a>
      </article>
      <article class="plan">
        <p class="meta">Pro</p>
        <p class="plan-price">€9<span> / month</span></p>
        <p class="plan-lead">Everything in Free, plus documents.</p>
        <ul>
          <li>A tailored CV for each posting</li>
          <li>A cover letter from the same facts</li>
          <li>Drafted answers, with the facts they used</li>
          <li>Six CV designs, typeset as real PDFs</li>
          <li>Every line traceable to its source</li>
        </ul>
        <a class="btn btn-ink" href="/login">Start with Pro</a>
        <p class="plan-note">
          Uses your own AI provider key, billed by your provider at cost: typically under €2 for
          a whole job search. jlog never marks it up.
        </p>
      </article>
    </div>

    <!-- ─────────────── Open source ─────────────── -->
    <section class="row oss">
      <div>
        <div class="kicker"><span class="kicker-n">MIT</span><span class="meta">Open source</span></div>
        <h2 class="h2">Self-host it.<br /><span class="dim">Bring your own model.</span></h2>
        <p class="body">
          It runs on Cloudflare's free tier. On the hosted version the extension records only the
          company, role and link on the six boards, fills forms without sending them anywhere,
          and reads a page only when you click Extract or Draft.
          <a href="/privacy">What is stored</a>, in plain words.
        </p>
        <div class="cta cta-left">
          {
            STORE_URL && (
              <a href={STORE_URL} class="btn btn-ink" target="_blank" rel="noopener noreferrer">
                Add to Chrome
              </a>
            )
          }
          <a href={GITHUB_URL} class="btn btn-line" target="_blank" rel="noopener noreferrer">
            Read the source
          </a>
        </div>
        {!STORE_URL && <p class="meta oss-note">Extension built from source until its store listing is live</p>}
      </div>
      <pre class="term" aria-label="Clone the repository"><span class="meta">~</span> git clone {GITHUB_URL}
<span class="meta">~</span> cd jlog && pnpm install
<span class="c"># then follow the README to deploy</span></pre>
    </section>

    <!-- ─────────────── FAQ ─────────────── -->
    <section class="row faq" id="faq">
      <div>
        <div class="kicker"><span class="kicker-n">?</span><span class="meta">FAQ</span></div>
        <h2 class="h2">Questions,<br /><span class="dim">answered.</span></h2>
      </div>
      <div class="faq-list">
        {
          faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ─────────────── Closer ─────────────── -->
    <section class="row closer">
      <h2 class="display closer-title">Start with the applications<br /><span class="dim">you have open now.</span></h2>
      <div class="cta">
        <a href="/login" class="btn btn-ink">Get started for free</a>
        <a href="/features/tailored-cv" class="btn btn-line">See the tailored CV</a>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</SiteLayout>

<script>
  /*
   * The stack separates as the hero scrolls through the viewport, and the
   * arrows are redrawn to follow each layer's anchor. Reduced motion gets the
   * stack already open and still.
   */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const svg = document.querySelector<SVGSVGElement>('[data-arrows]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';

  function drawArrows() {
    if (!stage || !svg) return;
    const box = stage.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    for (const old of svg.querySelectorAll('path.arrow')) old.remove();
    if (window.innerWidth < 1000) return;
    for (const note of stage.querySelectorAll<HTMLElement>('[data-note]')) {
      const id = note.dataset.note;
      const anchor = stage.querySelector<HTMLElement>(`[data-anchor="${id}"]`);
      if (!anchor) continue;
      const n = note.getBoundingClientRect();
      const a = anchor.getBoundingClientRect();
      const left = note.closest('.notes-left') !== null;
      const x1 = (left ? n.right + 10 : n.left - 10) - box.left;
      const y1 = n.top + 12 - box.top;
      const x2 = a.left + a.width / 2 - box.left;
      const y2 = a.top + a.height / 2 - box.top;
      const bend = (x2 - x1) * 0.55;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('class', 'arrow');
      path.setAttribute('d', `M${x1},${y1} C${x1 + bend},${y1 - 24} ${x2 - bend * 0.2},${y2 - 60} ${x2},${y2}`);
      path.setAttribute('marker-end', 'url(#tip)');
      svg.appendChild(path);
    }
  }

  function update() {
    if (!stage || !stack) return;
    const r = stage.getBoundingClientRect();
    const vh = window.innerHeight;
    // 0 when the stage's top reaches the bottom of the screen, 1 at the middle.
    const p = reduce ? 1 : Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
    const eased = 1 - (1 - p) ** 3;
    stack.style.setProperty('--gap', `${28 + eased * 78}px`);
    drawArrows();
  }

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(update);
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  document.fonts?.ready.then(schedule);
  update();

  /* The tailored-CV trace: two wires from a CV line to where it lands. */
  const trace = document.querySelector<HTMLElement>('[data-trace]');
  const wires = document.querySelector<SVGSVGElement>('[data-trace-wires]');
  function drawTrace() {
    if (!trace || !wires) return;
    const box = trace.getBoundingClientRect();
    wires.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    wires.replaceChildren();
    for (const [from, to] of [
      ['a', 'a2'],
      ['b', 'b2'],
    ]) {
      const f = trace.querySelector(`[data-t="${from}"]`)?.getBoundingClientRect();
      const t = trace.querySelector(`[data-t="${to}"]`)?.getBoundingClientRect();
      if (!f || !t) continue;
      const x1 = f.right - box.left;
      const y1 = f.top + f.height / 2 - box.top;
      const x2 = t.left - box.left;
      const y2 = t.top + t.height / 2 - box.top;
      const m = (x1 + x2) / 2;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', `M${x1},${y1} C${m},${y1} ${m},${y2} ${x2},${y2}`);
      wires.appendChild(path);
    }
  }
  window.addEventListener('resize', drawTrace);
  document.fonts?.ready.then(drawTrace);
  drawTrace();
</script>

<style>
  /* ---------- Hero ---------- */

  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(4rem, 9vw, 7rem);
    padding-bottom: 0;
    overflow: hidden;
    background:
      radial-gradient(circle at 1px 1px, var(--line-2) 1px, transparent 1.5px) 0 0 / 22px 22px;
  }

  .hero::before,
  .hero::after {
    display: none;
  }

  .announce {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem 0.25rem 0.3rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--bg);
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }

  .announce:hover {
    border-color: var(--grey-2);
  }

  .hero-title {
    max-width: 20ch;
  }

  .hero-lead {
    margin-top: 1.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .cta-left {
    justify-content: flex-start;
  }

  /* ---------- The stack ---------- */

  .stage {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 620px minmax(0, 1fr);
    align-items: center;
    margin-top: 4.5rem;
    color: var(--ink);
  }

  .arrows {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 3;
    color: var(--ink);
  }

  .arrows :global(.arrow) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.25;
  }

  .notes {
    list-style: none;
    display: grid;
    gap: 9rem;
    text-align: left;
    position: relative;
    z-index: 4;
  }

  .notes-left {
    justify-items: end;
    padding-right: 1rem;
  }

  .notes-right {
    padding-left: 1rem;
    padding-top: 2rem;
  }

  .note {
    display: grid;
    grid-template-columns: auto;
    gap: 0.25rem;
    max-width: 13rem;
    background: var(--bg);
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .note .kicker-n {
    justify-self: start;
  }

  .note-t {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .note-b {
    font-size: 0.8125rem;
    color: var(--grey);
    line-height: 1.4;
  }

  .scene {
    position: relative;
    height: 560px;
    perspective: 2400px;
  }

  .stack {
    --gap: 28px;
    position: absolute;
    left: 50%;
    top: 54%;
    width: 440px;
    height: 280px;
    margin: -140px 0 0 -220px;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(-38deg);
  }

  .layer {
    position: absolute;
