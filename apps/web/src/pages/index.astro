---
import { ProductDemo } from '../components/landing/ProductDemo';
import Layout from '../layouts/Layout.astro';

/*
 * The landing page.
 *
 * Two different jobs, deliberately split:
 *
 * - The hero carries a slanted, layered stack of UI fragments with a light
 *   running its leading edge. It is decoration and is marked aria-hidden. Its
 *   job is the four seconds before someone decides to keep reading.
 * - The section below mounts the REAL ApplicationsTable against fixtures. A
 *   visitor can filter it, change a status, walk it with j/k. That component
 *   was already presentational, so nothing had to be loosened to get it here.
 *
 * Flat and straight-on for the part you interact with, slanted for the part you
 * only look at. A demo rotated 16 degrees is a poster, not a demo.
 *
 * The old version of this page hand-drew four rows in CSS and called that the
 * product, which is how it sat on emoji feature cards through an entire
 * redesign without anyone noticing it had stopped describing anything.
 */

const GITHUB_URL = 'https://github.com/brgv-code/jlog';

const steps = [
  {
    id: 'capture',
    title: 'Capture',
    body: 'Apply on LinkedIn, Wellfound, Ashby, Greenhouse, Lever or YC and the row writes itself. Anywhere else, one click reads the page.',
  },
  {
    id: 'track',
    title: 'Track',
    body: 'Home leads with what needs you today — gone quiet, awaiting a reply, mid-interview — rather than with a count.',
  },
  {
    id: 'tailor',
    title: 'Tailor',
    body: 'A CV written for the posting in front of you, compiled to PDF from real LaTeX. Built from your history, not from a prompt.',
  },
];

/* Six boards with their own content script, named because the list is the claim. */
const BOARDS = ['LinkedIn', 'Wellfound', 'Ashby', 'Greenhouse', 'Lever', 'YC Jobs'];

/*
 * Diagrams, not previews. The gallery inside the app renders the real PDFs
 * (public/templates/*.pdf) through pdf.js; six canvases on a marketing page is
 * a lot of JavaScript to prove a point about layout. These abstract each
 * design's skeleton — where the name sits, whether there is a hint column.
 */
const templates = [
  { id: 'classic', label: 'Classic', hint: true },
  { id: 'banking', label: 'Banking', hint: false },
  { id: 'casual', label: 'Casual', hint: true },
  { id: 'oldstyle', label: 'Oldstyle', hint: false },
  { id: 'fancy', label: 'Fancy', hint: false },
  { id: 'plain', label: 'Plain', hint: false },
];
---

<Layout
  title="jlog — track every application, and write a CV for each one"
  description="An open-source job tracker that captures applications from the board you're already on, then writes a CV for each posting from your real history — every line traceable to something you wrote."
>
  <div class="page">
    <header class="nav">
      <a href="/" class="wordmark" aria-label="jlog home">
        <svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect class="mark-ground" width="32" height="32" rx="7"></rect>
          <circle class="mark-dot" cx="20" cy="6.5" r="2.2"></circle>
          <path
            class="mark-j"
            d="M20 12.5 V19.5 A4.25 4.25 0 0 1 11.5 19.5"
            stroke-width="4"
            stroke-linecap="round"></path>
        </svg>
        <span>jlog</span>
      </a>
      <nav class="nav-actions">
        <a href={GITHUB_URL} class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/login" class="nav-link">Sign in</a>
        <a href="/login" class="btn btn-primary">Get started free</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Open source · Self-hostable · Bring your own model</p>
        <h1 class="headline">
          Every job you apply to, captured.<br />
          Every CV you send, written for it.
        </h1>
        <p class="subheading">
          jlog logs the application from the job board you were already on, then writes a CV for
          that posting out of your real history — every line traceable back to something you
          actually wrote.
        </p>
        <div class="cta-row">
          <a href="/login" class="btn btn-primary btn-lg">Get started free</a>
          <a href={GITHUB_URL} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        </div>

        <!--
          Decorative, and aria-hidden: nothing here says anything the copy above
          has not. Four fragments of the app in perspective — the posting it
          reads, the pipeline it fills, the document it writes, and the compile
          that ends it — so the depth carries the sequence without a caption.

          The content is written out at real density rather than suggested with
          grey bars. A hero that abstracts the product into rectangles is a
          diagram of software; the detail is the part that reads as a real thing
          someone uses.
        -->
        <div class="stage" aria-hidden="true">
          <div class="glow"></div>
          <div class="stack">
            <!-- 1. The posting, furthest back and softest. -->
            <div class="layer layer-jd">
              <div class="bar">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="bar-url">jobs.ashbyhq.com/linear</span>
              </div>
              <div class="jd">
                <h3 class="jd-title">Senior Product Engineer</h3>
                <p class="jd-meta">Linear · Remote · Full-time</p>
                <p class="jd-p">
                  We are looking for a senior engineer to join the apps team and take ownership of
                  the surfaces our customers live in.
                </p>
                <p class="jd-h">What you'll do</p>
                <ul class="jd-list">
                  <li>Ship product surfaces end to end, from spec to release.</li>
                  <li class="jd-hit">Own our design system and component library.</li>
                  <li>Keep the app fast — performance is a feature here.</li>
                  <li>Work directly with designers on interaction detail.</li>
                </ul>
              </div>
            </div>

            <!-- 2. The pipeline. The widest panel and the centre of the composition. -->
            <div class="layer layer-list">
              <div class="bar">
                <span class="bar-title">Applications</span>
                <span class="bar-tools">
                  <span class="tab on">All</span>
                  <span class="tab">Applied</span>
                  <span class="tab">Interviewing</span>
                  <span class="search">Search company or role…</span>
                </span>
                <span class="bar-count">72</span>
              </div>
              <div class="rows">
                <div class="row">
                  <span class="mono-tile" data-h="14">S</span>
                  <span class="cell">
                    <span class="co">Stripe</span>
                    <span class="ro">Staff Frontend Engineer</span>
                  </span>
                  <span class="meta">Remote — EU · LinkedIn</span>
                  <span class="pill interviewing">Interviewing</span>
                </div>
                <div class="row row-on">
                  <span class="mono-tile" data-h="252">L</span>
                  <span class="cell">
                    <span class="co">Linear</span>
                    <span class="ro">Senior Product Engineer</span>
                  </span>
                  <span class="meta">Remote · Ashby</span>
                  <span class="pill applied">Applied</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="196">V</span>
                  <span class="cell">
                    <span class="co">Vercel</span>
                    <span class="ro">Developer Experience Engineer</span>
                  </span>
                  <span class="meta">Berlin, DE · Greenhouse</span>
                  <span class="pill offer">Offer</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="28">A</span>
                  <span class="cell">
                    <span class="co">Anthropic</span>
                    <span class="ro">Product Engineer</span>
                  </span>
                  <span class="meta">Remote — EU · Greenhouse</span>
                  <span class="pill interviewing">Interviewing</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="120">C</span>
                  <span class="cell">
                    <span class="co">Cloudflare</span>
                    <span class="ro">Systems Engineer, Workers</span>
                  </span>
                  <span class="meta">Lisbon, PT · Workday</span>
                  <span class="pill applied">Applied</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="320">R</span>
                  <span class="cell">
                    <span class="co">Raycast</span>
                    <span class="ro">Frontend Engineer</span>
                  </span>
                  <span class="meta">London, UK · Manual</span>
                  <span class="pill saved">Saved</span>
                </div>
              </div>
            </div>

            <!-- 3. The document, nearest and sharpest, on paper rather than UI. -->
            <div class="layer layer-cv">
              <svg class="comet" viewBox="0 0 400 260" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="cometTail" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0"></stop>
                    <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="1"></stop>
                  </linearGradient>
                </defs>
                <rect
                  x="1" y="1" width="398" height="258" rx="11"
                  fill="none" stroke="url(#cometTail)" stroke-width="2"
                  pathLength="100" stroke-dasharray="14 86" stroke-linecap="round"></rect>
              </svg>

              <div class="cv">
                <div class="cv-head">
                  <span class="cv-name">Alex Rivera</span>
                  <span class="cv-contact">alex@example.com · Berlin · github.com/arivera</span>
                </div>
                <p class="cv-sec">Experience</p>
                <div class="cv-entry">
                  <span class="cv-when">2021 — 2025</span>
                  <span class="cv-what">
                    <span class="cv-role">Senior Frontend Engineer, Acme</span>
                    <span class="cv-b">
                      Owned the <mark class="cite cite-jd">design system</mark> that
                      <mark class="cite cite-cv">40 engineers</mark> across 6 product teams built on.
                    </span>
                    <span class="cv-b">
                      Cut median dashboard load from <mark class="cite cite-cv">3.2s to 900ms</mark>
                      by code-splitting the bundle.
                    </span>
                  </span>
                </div>
                <div class="cv-entry">
                  <span class="cv-when">2018 — 2021</span>
                  <span class="cv-what">
                    <span class="cv-role">Frontend Engineer, Northwind</span>
                    <span class="cv-b">
                      Specified interaction and empty states with designers before build.
                    </span>
                  </span>
                </div>
              </div>

              <div class="cv-key">
                <span><i class="sw sw-cv"></i>your CV</span>
                <span><i class="sw sw-jd"></i>the posting</span>
              </div>
            </div>

            <!-- 4. The small one. Closest to the viewer, and the only thing moving
                 on its own, which is what makes the rest read as still rather
                 than as dead. -->
            <div class="layer layer-chip">
              <span class="ping"></span>
              <span class="chip-main">Compiled to PDF</span>
              <span class="chip-sub">tectonic · 1.8s · classic</span>
            </div>
          </div>
        </div>
      </section>

      <section class="proof reveal">
        <dl class="proof-grid">
          <div><dt>6</dt><dd>job boards captured automatically</dd></div>
          <div><dt>6</dt><dd>CV designs, compiled from LaTeX</dd></div>
          <div><dt>4</dt><dd>model providers, including local Ollama</dd></div>
          <div><dt>MIT</dt><dd>runs on Cloudflare's free tier</dd></div>
        </dl>
        <p class="proof-boards">
          {BOARDS.map((board) => <span class="board">{board}</span>)}
        </p>
      </section>

      <!--
        client:visible rather than client:load. This is below the fold on most
        screens, and a landing page that ships React before its own headline has
        painted is arguing against its first section.
      -->
      <section class="try reveal">
        <p class="eyebrow">Try it</p>
        <h2 class="section-title">The actual interface, with sample data</h2>
        <p class="section-body section-body-wide">
          Not a screenshot and not a drawing — the shipped component, running here. Filter it,
          change a status, click a generated line to see what it was written from.
        </p>
        <ProductDemo client:visible />
      </section>

      <section class="steps reveal">
        {
          steps.map((step) => (
            <article class="step">
              <svg class={`step-icon step-icon-${step.id}`} viewBox="0 0 24 24" aria-hidden="true">
                {step.id === 'capture' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v11" />
                    <path d="M8 10l4 4 4-4" />
                    <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
                  </g>
                )}
                {step.id === 'track' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 6h11" />
                    <path d="M9 12h11" />
                    <path d="M9 18h11" />
                    <path d="M4 6h.01" />
                    <path d="M4 12h.01" />
                    <path d="M4 18h.01" />
                  </g>
                )}
                {step.id === 'tailor' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />
                    <path d="M14 3v5h5" />
                    <path d="M20 13l-5.5 5.5-2.5.6.6-2.5L18.1 11a1.3 1.3 0 0 1 1.9 1.9z" />
                  </g>
                )}
              </svg>
              <h2 class="step-title">{step.title}</h2>
              <p class="step-body">{step.body}</p>
            </article>
          ))
        }
      </section>

      <section class="grounding reveal">
        <div class="grounding-copy">
          <p class="eyebrow">Grounding</p>
          <h2 class="section-title">Nothing it writes is unattributable</h2>
          <p class="section-body">
            Generation runs against a corpus of facts mined from your own CVs, not against a CV as
            a block of text. Every line keeps a pointer back to the fact it came from and the
            requirement it answers.
          </p>
          <p class="section-body">
            When a line matches nothing in the posting, it says so rather than inventing the link.
            A CV that quietly embellishes is worse than no CV — you find out in the interview.
          </p>
        </div>
        <ul class="grounding-facts">
          <li>
            <span class="fact-k">Traced to</span>
            <span class="fact-v">the sentence in your CV it was derived from</span>
          </li>
          <li>
            <span class="fact-k">And to</span>
            <span class="fact-v">the requirement in the posting it answers</span>
          </li>
          <li>
            <span class="fact-k">Output</span>
            <span class="fact-v">real LaTeX, compiled to PDF — not HTML pretending</span>
          </li>
          <li>
            <span class="fact-k">Unmatched</span>
            <span class="fact-v">flagged, never fabricated</span>
          </li>
        </ul>
      </section>

      <section class="templates reveal">
        <p class="eyebrow">Templates</p>
        <h2 class="section-title">Six designs, not six countries</h2>
        <p class="section-body section-body-wide">
          A template is a design. Where conventions differ — whether a photo belongs on the page,
          how long it runs — that is a property of the design you picked, applied for you, not a
          country you have to choose first.
        </p>
        <ul class="template-strip">
          {
            templates.map((template) => (
              <li class="template">
                <div class={`sheet sheet-${template.id}`} aria-hidden="true">
                  <span class="sheet-head">
                    <span class="sheet-name" />
                  </span>
                  <span class="sheet-main">
                    {template.hint && <span class="sheet-hint" />}
                    <span class="sheet-body" />
                  </span>
                </div>
                <span class="template-label">{template.label}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="oss reveal">
        <p class="eyebrow">Self-hosting</p>
        <h2 class="section-title">Yours, including the parts you'd rather not hand over</h2>
        <p class="section-body">
          MIT licensed, and it runs on Cloudflare's free tier. Self-host the whole thing on your
          own account and your application history never leaves it. Bring your own key for
          Anthropic, OpenAI or Gemini, or point it at a local Ollama and send nothing anywhere.
        </p>
        <div class="oss-actions">
          <a href={GITHUB_URL} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            Read the source
          </a>
          <span class="oss-note">
            The extension is built from source — there is no Chrome Web Store listing yet.
          </span>
        </div>
      </section>

      <section class="closer reveal">
        <h2 class="closer-title">Start with the applications you have open now.</h2>
        <a href="/login" class="btn btn-primary btn-lg">Get started free</a>
      </section>
    </main>

    <footer class="footer">
      <span>jlog · MIT licensed</span>
      <span class="footer-sep" aria-hidden="true"></span>
      <span>Tracking is free. Tailored documents are a paid feature.</span>
      <a href={GITHUB_URL} class="footer-link" target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>
  </div>
</Layout>

<!--
  Scroll reveal and the hero's pointer tilt. Inline and dependency-free: two
  small handlers do not justify a library, and this has to run before hydration
  or the sections below sit invisible until React arrives.

  Everything here is additive. Sections are visible by default and only hidden
  once the script has confirmed it can animate them, so a visitor with JS off
  gets the page rather than a blank column. Both effects are skipped entirely
  under prefers-reduced-motion.
-->
<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;

    const pending = new Set(document.querySelectorAll('.reveal'));
    for (const el of pending) el.classList.add('will-reveal');

    /*
     * Driven by scroll position rather than by IntersectionObserver.
     *
     * An observer only fires when the intersection ratio changes, and a jump —
     * pressing End, restoring scroll on reload, following a deep link — takes a
     * section from below the viewport to above it without ever intersecting. No
     * callback fires and the section stays at opacity 0 for the life of the
     * page. Asking "is its top above the fold line" instead is correct for both
     * a scroll and a jump, and it self-detaches once everything is shown.
     */
    const check = () => {
      for (const el of pending) {
        if (el.getBoundingClientRect().top < window.innerHeight * 0.88) {
          el.classList.add('revealed');
          pending.delete(el);
        }
      }
      if (pending.size === 0) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }
    };

    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        check();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    check();

    // Pointer tilt, fine pointers only: on a touch screen there is no hover to
    // respond to, and the handler would only cost battery.
    const stage = document.querySelector('.stage');
    if (!stage || !window.matchMedia('(pointer: fine)').matches) return;

    let tiltFrame = 0;
    stage.addEventListener('pointermove', (e) => {
      if (tiltFrame) return;
      tiltFrame = requestAnimationFrame(() => {
        tiltFrame = 0;
        const box = stage.getBoundingClientRect();
        const x = (e.clientX - box.left) / box.width - 0.5;
        const y = (e.clientY - box.top) / box.height - 0.5;
        stage.style.setProperty('--tilt-y', `${x * 7}deg`);
        stage.style.setProperty('--tilt-x', `${-y * 5}deg`);
      });
    });

    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--tilt-y', '0deg');
      stage.style.setProperty('--tilt-x', '0deg');
    });
  })();
</script>

<style>
  /* ---------- shell ---------- */

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
  }

  main {
    flex: 1;
  }

  section {
    max-width: 1128px;
    margin: 0 auto;
    width: 100%;
    padding: var(--space-16) var(--space-6);
  }

  .proof,
  .try,
  .steps,
  .grounding,
  .templates,
  .oss,
  .closer {
    border-top: 1px solid var(--color-border);
  }

  /*
   * The mono eyebrow. The one thing here the app does not do: inside jlog, mono
   * means "a value you copy". On a page with seven sections and no navigation
   * it earns a second job, as the label that gives each section a top edge.
   */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .section-body {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .section-body + .section-body {
    margin-top: var(--space-4);
  }

  .section-body-wide {
    margin-bottom: var(--space-10);
  }

  /* ---------- motion ---------- */

  .will-reveal {
    opacity: 0;
    transform: translateY(12px);
  }

  .revealed {
    opacity: 1;
    transform: none;
    transition: opacity 480ms ease-out, transform 480ms ease-out;
  }

  /*
   * Nothing scrolls a printed page, so the observer never fires and every
   * section below the hero would come out blank. Same reasoning applies to any
   * renderer that paginates rather than scrolls.
   */
  @media print {
    .will-reveal {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- nav ---------- */

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 56px;
    padding: 0 var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .wordmark-mark {
    width: 22px;
    height: 22px;
    display: block;
  }

  /*
   * Filled from CSS rather than from fill="var(--…)" presentation attributes:
   * those resolve in Chrome and Firefox but have a history of not resolving in
   * Safari, and a wordmark that renders as a black square on one browser is not
   * worth the two saved lines. This also lets the mark invert with the theme.
   */
  .mark-ground {
    fill: var(--color-primary);
  }

  .mark-dot {
    fill: var(--color-accent);
  }

  .mark-j {
    fill: none;
    stroke: var(--color-primary-fg);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* ---------- buttons ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    padding: 7px 16px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  /* The one loud thing on the page. */
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border: 1px solid var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
  }

  .btn-ghost:hover {
    background: var(--color-surface-hover);
  }

  .btn-lg {
    padding: 11px 22px;
    font-size: var(--text-base);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .headline {
    font-size: var(--text-5xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    /*
     * No ch cap. The <br> sets the break, and a measure narrow enough to be
     * useful for prose re-wrapped a two-line headline into four. The clamp on
     * --text-5xl is what keeps it in bounds at small widths instead.
     */
    text-wrap: balance;
  }

  .subheading {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .cta-row {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---------- the slanted stack ---------- */

  /*
   * The hero visual.
   *
   * Four layers at different translateZ inside one perspective. Parallax is not
   * simulated — rotating .stack rotates genuinely separated planes, so the
   * layers slide past each other at rates set by their Z, the way they would if
   * they were really at different distances.
   *
   * Depth of field is doing most of the work that "3D" usually gets credit for:
   * the far layer is blurred and desaturated, the near one is sharp. Without it
   * four sharp panels read as four stickers on glass.
   */
  .stage {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    /* The highlight a panel edge catches from the notional light above-left.
       Near-white on paper; on a dark ground that same value reads as a drawn
       white line rather than as a lit edge, so it drops to a sixth of it. */
    --edge-light: color-mix(in srgb, #fff 70%, transparent);
    position: relative;
    width: 100vw;
    /* Break the section's measure. The composition wants to run past the text
       column and bleed off both edges, so it reads as a window onto something
       larger rather than as a picture pasted into the page. */
    margin-left: calc(50% - 50vw);
    margin-top: var(--space-10);
    margin-bottom: calc(var(--space-16) * -1);
    height: 660px;
    perspective: 2000px;
    perspective-origin: 52% 42%;
    overflow: hidden;
    /* The hero centres its copy; the panels are interface and documents, which
       are set left. Without this every row label and CV bullet inherits the
       centring and the whole stack stops looking like software. */
    text-align: left;
  }

  .glow {
    position: absolute;
    inset: 6% 18% 10%;
    background:
      radial-gradient(
        ellipse 55% 60% at 42% 45%,
        color-mix(in srgb, var(--color-accent) 22%, transparent) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 40% 50% at 68% 62%,
        color-mix(in srgb, var(--color-cite-cv) 18%, transparent) 0%,
        transparent 72%
      );
    filter: blur(60px);
    pointer-events: none;
  }

  .stack {
    position: absolute;
    /* Sized and centred as a fixed 1240px composition so the layout does not
       reflow with the viewport — it scales, which keeps the geometry honest. */
    width: 1240px;
    height: 660px;
    left: 50%;
    top: 0;
    margin-left: -620px;
    transform-style: preserve-3d;
    transform: rotateX(calc(9deg + var(--tilt-x))) rotateY(calc(-15deg + var(--tilt-y)));
    transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .layer {
    position: absolute;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    transform-style: preserve-3d;
    /* A light source at upper-left: a hairline highlight on the top edge and a
       long shadow below. Two lines, and it is most of what makes a flat panel
       look like a physical one. */
    box-shadow:
      inset 0 1px 0 var(--edge-light),
      var(--shadow-lg);
    animation: float 9s ease-in-out infinite;
  }

  /* Staggered so the four never bob in unison, which is what makes float
     animations look mechanical. */
  .layer-jd {
    width: 430px;
    left: 40px;
    top: 26px;
    transform: translateZ(-190px);
    opacity: 0.82;
    filter: blur(1.4px) saturate(0.82);
    animation-duration: 11s;
  }

  .layer-list {
    width: 620px;
    left: 258px;
    top: 148px;
    transform: translateZ(-30px);
    filter: blur(0.35px);
    animation-duration: 9.5s;
    animation-delay: -2.4s;
  }

  .layer-cv {
    width: 400px;
    left: 706px;
    top: 276px;
    transform: translateZ(140px);
    background: var(--color-paper);
    animation-duration: 8.5s;
    animation-delay: -5.1s;
  }

  .layer-chip {
    width: 214px;
    left: 940px;
    top: 132px;
    transform: translateZ(250px);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: var(--color-surface);
    animation-duration: 7s;
    animation-delay: -1.2s;
  }

  /* `translate` is its own property, so this composes with the transform above
     instead of fighting it. */
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -13px;
    }
  }

  /* ---- window chrome / panel bars ---- */

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 9px var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    font-size: 11px;
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }

  .bar-url {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    font-size: 10px;
  }

  .bar-title {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    font-size: 10px;
  }

  .bar-tools {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: var(--space-2);
  }

  .tab {
    padding: 3px 8px;
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 10px;
  }

  .tab.on {
    background: var(--color-surface-active);
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .search {
    margin-left: var(--space-2);
    padding: 3px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text-tertiary);
    font-size: 10px;
    white-space: nowrap;
  }

  .bar-count {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    font-size: 10px;
  }

  /* ---- the posting ---- */

  .jd {
    padding: var(--space-4);
  }

  .jd-title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .jd-meta {
    margin-top: 2px;
    font-size: 11px;
    color: var(--color-text-tertiary);
  }

  .jd-p {
    margin-top: var(--space-3);
    font-size: 11px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .jd-h {
    margin-top: var(--space-4);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  .jd-list {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .jd-list li {
    font-size: 11px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* The requirement the generated bullet on the front layer answers. */
  .jd-hit {
    list-style: none;
    margin-left: calc(var(--space-4) * -1);
    padding: 3px var(--space-2) 3px var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-cite-jd-fill);
    box-shadow: inset 2px 0 0 var(--color-cite-jd);
    color: var(--color-text-primary);
  }

  /* ---- the pipeline ---- */

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 9px var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row-on {
    background: var(--color-surface-raised);
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  /* The same hashed-hue monogram the real list draws when an employer has no
     cached logo, which is most of them. */
  .mono-tile {
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    background-color: hsl(var(--h) 46% 91%);
    color: hsl(var(--h) 42% 32%);
  }

  /* Mirrors [data-theme="dark"] .jlog-monogram in tokens.css. Without it the
     hero keeps light tiles while the real list below it flips, and the two are
     on screen within one scroll of each other. */
  :global([data-theme='dark']) .mono-tile {
    background-color: hsl(var(--h) 24% 17%);
    color: hsl(var(--h) 46% 72%);
  }

  :global([data-theme='dark']) .stage {
    --edge-light: color-mix(in srgb, #fff 11%, transparent);
  }

  .mono-tile[data-h='14'] {
    --h: 14;
  }
  .mono-tile[data-h='28'] {
    --h: 28;
  }
  .mono-tile[data-h='120'] {
    --h: 120;
  }
  .mono-tile[data-h='196'] {
    --h: 196;
  }
  .mono-tile[data-h='252'] {
    --h: 252;
  }
  .mono-tile[data-h='320'] {
    --h: 320;
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    flex: 1;
  }

  .co {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ro {
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .meta {
    font-size: 10px;
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .pill {
    display: inline-block;
    padding: 2px 9px;
    border-radius: var(--radius-full);
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
    flex: none;
    width: 78px;
    text-align: center;
  }

  .pill.saved {
    color: var(--color-status-saved);
    background: color-mix(in srgb, var(--color-status-saved) 12%, transparent);
  }

  .pill.applied {
    color: var(--color-status-applied);
    background: color-mix(in srgb, var(--color-status-applied) 12%, transparent);
  }

  .pill.interviewing {
    color: var(--color-status-interviewing);
    background: color-mix(in srgb, var(--color-status-interviewing) 12%, transparent);
  }

  .pill.offer {
    color: var(--color-status-offer);
    background: color-mix(in srgb, var(--color-status-offer) 12%, transparent);
  }

  /* ---- the document ---- */

  .cv {
    padding: var(--space-5) var(--space-5) var(--space-3);
    color: var(--color-paper-ink);
  }

  .cv-head {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper-ink) 18%, transparent);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cv-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .cv-contact {
    font-size: 9.5px;
    color: color-mix(in srgb, var(--color-paper-ink) 58%, transparent);
  }

  .cv-sec {
    margin-top: var(--space-4);
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--color-paper-ink) 62%, transparent);
  }

  /* moderncv's hint column: dates left, entry right. */
  .cv-entry {
    margin-top: var(--space-3);
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: var(--space-3);
  }

  .cv-when {
    font-size: 9.5px;
    text-align: right;
    padding-top: 1px;
    color: color-mix(in srgb, var(--color-paper-ink) 55%, transparent);
  }

  .cv-what {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cv-role {
    font-size: 11px;
    font-weight: 600;
  }

  .cv-b {
    font-size: 10.5px;
    line-height: 1.55;
  }

  .cite {
    background: none;
    color: inherit;
    padding-bottom: 1px;
  }

  .cite-cv {
    box-shadow: inset 0 -2px 0 var(--color-cite-cv);
    background: var(--color-cite-cv-fill);
  }

  .cite-jd {
    box-shadow: inset 0 -2px 0 var(--color-cite-jd);
    background: var(--color-cite-jd-fill);
  }

  .cv-key {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-5) var(--space-3);
    font-size: 9.5px;
    color: color-mix(in srgb, var(--color-paper-ink) 58%, transparent);
  }

  .cv-key span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sw {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
  }

  .sw-cv {
    background: var(--color-cite-cv);
  }

  .sw-jd {
    background: var(--color-cite-jd);
  }

  /* ---- the compile chip ---- */

  .chip-main {
    font-size: 11px;
    font-weight: 500;
  }

  .chip-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--color-text-tertiary);
  }

  /* The one genuinely live element. A status light that has just gone green
     says the thing finished; four still panels cannot. */
  .ping {
    position: absolute;
    top: 13px;
    right: 13px;
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--color-status-offer);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-status-offer) 60%, transparent);
    animation: ping 2.6s ease-out infinite;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-status-offer) 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  /* ---- the comet ---- */

  .comet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: visible;
  }

  .comet rect {
    animation: comet 4.5s linear infinite;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-accent) 70%, transparent));
  }

  @keyframes comet {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /*
   * Everything above is ornament. Under prefers-reduced-motion the composition
   * stays exactly as it is and simply stops moving — the layout is the content,
   * the animation is not.
   */
  @media (prefers-reduced-motion: reduce) {
    .layer,
    .comet rect,
    .ping {
      animation: none;
    }
  }


  /* ---------- proof band ---------- */

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  .proof-grid dt {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .proof-grid dd {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .proof-boards {
    margin-top: var(--space-10);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .board {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 4px 11px;
  }

  /* ---------- steps ---------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .step {
    padding: 0 var(--space-6);
  }

  .step:first-child {
    padding-left: 0;
  }

  .step + .step {
    border-left: 1px solid var(--color-border);
  }

  .step-icon {
    width: 22px;
    height: 22px;
    display: block;
    margin-bottom: var(--space-4);
  }

  /* The sidebar's per-destination hues, reused so the page and the app agree. */
  .step-icon-capture {
    color: var(--color-icon-applications);
  }

  .step-icon-track {
    color: var(--color-icon-home);
  }

  .step-icon-tailor {
    color: var(--color-icon-cv);
  }

  .step-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .step-body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* ---------- grounding ---------- */

  .grounding {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .grounding-facts {
    list-style: none;
  }

  .grounding-facts li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .grounding-facts li:first-child {
    padding-top: 0;
  }

  .grounding-facts li:last-child {
    border-bottom: none;
  }

  .fact-k {
    color: var(--color-text-tertiary);
  }

  .fact-v {
    color: var(--color-text-primary);
  }

  /* ---------- templates ---------- */

  .template-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .template {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /*
   * Each sheet is a diagram of one design's skeleton. The differences that
   * matter when picking are where the name sits and whether there is a hint
   * column beside the body — moderncv's classic and casual carry one, the rest
   * run full width — so those are the only things drawn. Anything more detailed
   * would be inventing output the compiler has not produced.
   */
  .sheet {
    aspect-ratio: 1 / 1.414;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 11%;
    display: flex;
    flex-direction: column;
    gap: 8%;
    overflow: hidden;
  }

  .sheet-head {
    display: block;
    flex: none;
  }

  .sheet-name {
    display: block;
    height: 7px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-paper-ink) 34%, transparent);
  }

  .sheet-main {
    display: flex;
    flex: 1;
    gap: 8%;
    min-height: 0;
  }

  .sheet-hint,
  .sheet-body {
    display: block;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 7px
    );
  }

  .sheet-body {
    flex: 1;
  }

  /* The narrow dates/keywords column moderncv puts left of the entries. */
  .sheet-hint {
    width: 27%;
    flex: none;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 21px
    );
  }

  .sheet-classic .sheet-name {
    width: 54%;
  }

  .sheet-banking .sheet-head {
    border-bottom: 1.5px solid color-mix(in srgb, var(--color-paper-ink) 28%, transparent);
    padding-bottom: 7%;
  }

  .sheet-banking .sheet-name {
    width: 62%;
    margin: 0 auto;
  }

  .sheet-casual .sheet-name {
    width: 46%;
    height: 12px;
  }

  .sheet-oldstyle .sheet-name {
    width: 50%;
    margin: 0 auto;
  }

  .sheet-oldstyle .sheet-body {
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 10px
    );
  }

  .sheet-fancy .sheet-head {
    background: color-mix(in srgb, var(--color-paper-ink) 20%, transparent);
    padding: 5% 6%;
    border-radius: 1px;
  }

  .sheet-fancy .sheet-name {
    width: 58%;
    height: 6px;
    background: color-mix(in srgb, var(--color-paper-ink) 45%, transparent);
  }

  .sheet-plain .sheet-name {
    width: 36%;
    height: 5px;
    background: color-mix(in srgb, var(--color-paper-ink) 26%, transparent);
  }

  .sheet-plain .sheet-body {
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-paper-ink) 15%, transparent) 0 2px,
      transparent 2px 5px
    );
  }

  .template-label {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  /* ---------- open source ---------- */

  .oss-actions {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .oss-note {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    max-width: 40ch;
