---
import Layout from '../layouts/Layout.astro';

/*
 * The landing page.
 *
 * Built from tokens.css and hand-written CSS rather than from the app's React
 * components: everything below the nav is a *depiction* of the product, not the
 * product. The applications table is a live island backed by a fetch; putting it
 * on a marketing page would mean shipping React, the API client and an empty
 * state to a signed-out visitor to show four fake rows.
 *
 * The cost of that choice is real and worth naming: this file duplicates the
 * look of surfaces it cannot import, so it goes stale silently when they change.
 * It already did once — it sat on emoji feature cards through an entire
 * redesign. If the app's list or citation view changes shape, this changes too.
 *
 * Rules it follows, from DESIGN.md: dividers rather than boxes, one black
 * primary action, and colour only where it carries meaning — here that is
 * application status, the two citation sources, and the three section icons
 * that reuse the sidebar's per-destination hues.
 */

const GITHUB_URL = 'https://github.com/brgv-code/jlog';

const steps = [
  {
    id: 'capture',
    title: 'Capture',
    body: 'The extension notices when you apply on LinkedIn, Wellfound, Ashby, Greenhouse, Lever or YC. Anywhere else, one click reads the page and fills the row in for you.',
  },
  {
    id: 'track',
    title: 'Track',
    body: 'Saved, applied, interviewing, offer. Home leads with what actually needs you today — what has gone quiet, what is waiting on a reply, what is mid-interview.',
  },
  {
    id: 'tailor',
    title: 'Tailor',
    body: 'A CV written for the posting in front of you, compiled to PDF from real LaTeX. Built from your history, not from a prompt that has read your CV once.',
  },
];

/*
 * Diagrams, not previews. The gallery inside the app renders the real PDFs
 * (public/templates/*.pdf) through pdf.js; six canvases on a marketing page is
 * a lot of JavaScript to prove a point about layout. These are abstractions of
 * each design's shape — where the header sits, one column or two — which is the
 * part that differs and the part someone is choosing between.
 */
const templates = [
  { id: 'classic', label: 'Classic', hint: true },
  { id: 'banking', label: 'Banking', hint: false },
  { id: 'casual', label: 'Casual', hint: true },
  { id: 'oldstyle', label: 'Oldstyle', hint: false },
  { id: 'fancy', label: 'Fancy', hint: false },
  { id: 'plain', label: 'Plain', hint: false },
];
---

<Layout
  title="jlog — track every application, and write a CV for each one"
  description="An open-source job tracker that captures applications from the board you're already on, then writes a CV for each posting from your real history — every line traceable to something you wrote."
>
  <div class="page">
    <header class="nav">
      <a href="/" class="wordmark" aria-label="jlog home">
        <svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect class="mark-ground" width="32" height="32" rx="7"></rect>
          <circle class="mark-dot" cx="20" cy="6.5" r="2.2"></circle>
          <path
            class="mark-j"
            d="M20 12.5 V19.5 A4.25 4.25 0 0 1 11.5 19.5"
            stroke-width="4"
            stroke-linecap="round"></path>
        </svg>
        <span>jlog</span>
      </a>
      <nav class="nav-actions">
        <a href={GITHUB_URL} class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/login" class="nav-link">Sign in</a>
        <a href="/login" class="btn btn-primary">Get started free</a>
      </nav>
    </header>

    <main>
      <!--
        The split hero. Two panels, but deliberately not two coequal columns:
        the highlighted row on the left is the job the document on the right was
        written for, and the connector between them is the product. Read as a
        menu of two features it would sell neither.
      -->
      <section class="hero">
        <h1 class="headline">
          Every job you apply to, captured.<br />
          Every CV you send, written for it.
        </h1>
        <p class="subheading">
          jlog logs the application from the job board you were already on, then writes a CV for
          that posting out of your real history — with every line traceable back to something you
          actually wrote.
        </p>
        <div class="cta-row">
          <a href="/login" class="btn btn-primary btn-lg">Get started free</a>
          <a href={GITHUB_URL} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        </div>

        <div class="split" aria-hidden="true">
          <div class="panel">
            <div class="panel-head">
              <span class="panel-title">Applications</span>
              <span class="panel-meta">72</span>
            </div>
            <div class="rows">
              <div class="row">
                <span class="row-company">Stripe</span>
                <span class="badge interviewing">Interviewing</span>
              </div>
              <div class="row row-selected">
                <span class="row-company">Linear</span>
                <span class="badge applied">Applied</span>
              </div>
              <div class="row">
                <span class="row-company">Vercel</span>
                <span class="badge offer">Offer</span>
              </div>
              <div class="row">
                <span class="row-company">Figma</span>
                <span class="badge saved">Saved</span>
              </div>
            </div>
          </div>

          <div class="connector">
            <span class="connector-line"></span>
            <svg class="connector-chevron" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M6 3l5 5-5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>

          <div class="panel panel-doc">
            <div class="panel-head">
              <span class="panel-title">CV · Linear</span>
              <span class="panel-meta">Frontend Engineer</span>
            </div>
            <div class="doc">
              <p class="doc-line">
                Owned the <mark class="cite cite-jd">design system</mark> that
                <mark class="cite cite-cv">40 engineers</mark> built on, cutting UI review time in half.
              </p>
              <p class="doc-line doc-line-dim"></p>
              <p class="doc-line doc-line-dim doc-line-short"></p>
            </div>
            <div class="doc-key">
              <span class="key"><span class="swatch swatch-cv"></span>your CV</span>
              <span class="key"><span class="swatch swatch-jd"></span>the posting</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Three steps, divided rather than boxed (DESIGN.md rule 2). -->
      <section class="steps">
        {
          steps.map((step) => (
            <article class="step">
              <svg class={`step-icon step-icon-${step.id}`} viewBox="0 0 24 24" aria-hidden="true">
                {step.id === 'capture' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v11" />
                    <path d="M8 10l4 4 4-4" />
                    <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
                  </g>
                )}
                {step.id === 'track' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 6h11" />
                    <path d="M9 12h11" />
                    <path d="M9 18h11" />
                    <path d="M4 6h.01" />
                    <path d="M4 12h.01" />
                    <path d="M4 18h.01" />
                  </g>
                )}
                {step.id === 'tailor' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />
                    <path d="M14 3v5h5" />
                    <path d="M20 13l-5.5 5.5-2.5.6.6-2.5L18.1 11a1.3 1.3 0 0 1 1.9 1.9z" />
                  </g>
                )}
              </svg>
              <h2 class="step-title">{step.title}</h2>
              <p class="step-body">{step.body}</p>
            </article>
          ))
        }
      </section>

      <!--
        The one claim nothing else in this category makes, so it gets a section
        rather than a bullet.
      -->
      <section class="grounding">
        <div class="grounding-copy">
          <h2 class="section-title">Nothing it writes is unattributable</h2>
          <p class="section-body">
            Generation runs against a corpus of facts pulled out of your own CV, not against the
            CV as a block of text. Every line it produces keeps a pointer back to the fact it came
            from and the requirement it was written for, and the app draws the connection.
          </p>
          <p class="section-body">
            When a line matches nothing in the posting, it says so rather than inventing the link.
            That is the part that matters: a CV that quietly embellishes is worse than no CV at
            all, because you find out in the interview.
          </p>
        </div>
        <ul class="grounding-facts">
          <li>
            <span class="fact-k">Traced to</span>
            <span class="fact-v">the sentence in your CV it was derived from</span>
          </li>
          <li>
            <span class="fact-k">And to</span>
            <span class="fact-v">the requirement in the posting it answers</span>
          </li>
          <li>
            <span class="fact-k">Output</span>
            <span class="fact-v">real LaTeX, compiled to PDF — not HTML pretending</span>
          </li>
          <li>
            <span class="fact-k">Unmatched</span>
            <span class="fact-v">flagged, never fabricated</span>
          </li>
        </ul>
      </section>

      <section class="templates">
        <h2 class="section-title">Six designs, not six countries</h2>
        <p class="section-body section-body-wide">
          A template is a design. Where the conventions differ — whether a photo belongs on the
          page, how long it runs — that is a property of the design you picked, applied for you,
          not a country you have to choose first.
        </p>
        <ul class="template-strip">
          {
            templates.map((template) => (
              <li class="template">
                <div class={`sheet sheet-${template.id}`} aria-hidden="true">
                  <span class="sheet-head">
                    <span class="sheet-name" />
                  </span>
                  <span class="sheet-main">
                    {template.hint && <span class="sheet-hint" />}
                    <span class="sheet-body" />
                  </span>
                </div>
                <span class="template-label">{template.label}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="oss">
        <div class="oss-copy">
          <h2 class="section-title">Yours, including the parts you'd rather not hand over</h2>
          <p class="section-body">
            jlog is MIT licensed and runs on Cloudflare's free tier. Self-host the whole thing on
            your own account and your application history never leaves it. Bring your own key for
            Anthropic, OpenAI or Gemini, or point it at a local Ollama and send nothing anywhere.
          </p>
          <div class="oss-actions">
            <a href={GITHUB_URL} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              Read the source
            </a>
            <span class="oss-note">
              The extension is built from source — there is no Chrome Web Store listing yet.
            </span>
          </div>
        </div>
      </section>

      <section class="closer">
        <h2 class="closer-title">Start with the applications you have open now.</h2>
        <a href="/login" class="btn btn-primary btn-lg">Get started free</a>
      </section>
    </main>

    <footer class="footer">
      <span>jlog · MIT licensed</span>
      <span class="footer-sep" aria-hidden="true"></span>
      <span>Tracking is free. Tailored documents are a paid feature.</span>
      <a href={GITHUB_URL} class="footer-link" target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>
  </div>
</Layout>

<style>
  /* ---------- shell ---------- */

  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
  }

  main {
    flex: 1;
  }

  section {
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
    padding: var(--space-16) var(--space-6);
  }

  /* Sections separate with a hairline. No cards. */
  .steps,
  .grounding,
  .templates,
  .oss,
  .closer {
    border-top: 1px solid var(--color-border);
    max-width: 1128px;
  }

  .section-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin-bottom: var(--space-4);
  }

  .section-body {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 62ch;
  }

  .section-body + .section-body {
    margin-top: var(--space-4);
  }

  .section-body-wide {
    margin-bottom: var(--space-10);
  }

  /* ---------- nav ---------- */

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 56px;
    padding: 0 var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: var(--text-base);
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .wordmark-mark {
    width: 22px;
    height: 22px;
    display: block;
  }

  /*
   * Filled from CSS rather than from fill="var(--…)" presentation attributes:
   * those resolve in Chrome and Firefox but have a history of not resolving in
   * Safari, and a wordmark that renders as a black square on one browser is not
   * worth the two saved lines. This also lets the mark invert with the theme.
   */
  .mark-ground {
    fill: var(--color-primary);
  }

  .mark-dot {
    fill: var(--color-accent);
  }

  .mark-j {
    fill: none;
    stroke: var(--color-primary-fg);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-link {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* ---------- buttons ---------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    padding: 7px 16px;
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  /* The one loud thing on the page. */
  .btn-primary {
    background: var(--color-primary);
    color: var(--color-primary-fg);
    border: 1px solid var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-strong);
  }

  .btn-ghost:hover {
    background: var(--color-surface-hover);
  }

  .btn-lg {
    padding: 11px 22px;
    font-size: var(--text-base);
  }

  /* ---------- hero ---------- */

  .hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .headline {
    font-size: var(--text-5xl);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    /*
     * No ch cap. The <br> sets the break, and a measure narrow enough to be
     * useful for prose re-wrapped a two-line headline into four. The clamp on
     * --text-5xl is what keeps it in bounds at small widths instead.
     */
    text-wrap: balance;
  }

  .subheading {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 60ch;
  }

  .cta-row {
    margin-top: var(--space-8);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ---------- the split ---------- */

  .split {
    margin-top: var(--space-16);
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    text-align: left;
  }

  .panel {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .panel-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .panel-meta {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row-selected {
    background: var(--color-surface-raised);
  }

  .row-company {
    font-weight: 500;
  }

  .badge {
    display: inline-block;
    padding: 2px 9px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 500;
    white-space: nowrap;
  }

  .badge.saved {
    color: var(--color-status-saved);
    background: color-mix(in srgb, var(--color-status-saved) 10%, transparent);
  }

  .badge.applied {
    color: var(--color-status-applied);
    background: color-mix(in srgb, var(--color-status-applied) 10%, transparent);
  }

  .badge.interviewing {
    color: var(--color-status-interviewing);
    background: color-mix(in srgb, var(--color-status-interviewing) 10%, transparent);
  }

  .badge.offer {
    color: var(--color-status-offer);
    background: color-mix(in srgb, var(--color-status-offer) 10%, transparent);
  }

  .connector {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
  }

  .connector-line {
    display: block;
    width: var(--space-6);
    height: 1px;
    background: var(--color-border-strong);
  }

  .connector-chevron {
    width: 16px;
    height: 16px;
    display: block;
    margin-left: -2px;
  }

  /* The generated document reads as paper, not as more UI. */
  .panel-doc {
    background: var(--color-paper);
  }

  .doc {
    padding: var(--space-4);
  }

  .doc-line {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-paper-ink);
  }

  /* Stand-ins for the rest of the page — bars, so no one reads them as copy. */
  .doc-line-dim {
    height: 7px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-paper-ink) 12%, transparent);
    margin-top: var(--space-4);
  }

  .doc-line-short {
    width: 58%;
  }

  .cite {
    background: none;
    color: inherit;
    padding-bottom: 1px;
  }

  .cite-cv {
    box-shadow: inset 0 -2px 0 var(--color-cite-cv);
    background: var(--color-cite-cv-fill);
  }

  .cite-jd {
    box-shadow: inset 0 -2px 0 var(--color-cite-jd);
    background: var(--color-cite-jd-fill);
  }

  .doc-key {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    display: inline-block;
  }

  .swatch-cv {
    background: var(--color-cite-cv);
  }

  .swatch-jd {
    background: var(--color-cite-jd);
  }

  /* ---------- steps ---------- */

  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .step {
    padding: 0 var(--space-6);
  }

  .step:first-child {
    padding-left: 0;
  }

  .step + .step {
    border-left: 1px solid var(--color-border);
  }

  .step-icon {
    width: 22px;
    height: 22px;
    display: block;
    margin-bottom: var(--space-4);
  }

  /* The sidebar's per-destination hues, reused so the page and the app agree. */
  .step-icon-capture {
    color: var(--color-icon-applications);
  }

  .step-icon-track {
    color: var(--color-icon-home);
  }

  .step-icon-tailor {
    color: var(--color-icon-cv);
  }

  .step-title {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .step-body {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  /* ---------- grounding ---------- */

  .grounding {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .grounding-facts {
    list-style: none;
  }

  .grounding-facts li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .grounding-facts li:first-child {
    padding-top: 0;
  }

  .grounding-facts li:last-child {
    border-bottom: none;
  }

  .fact-k {
    color: var(--color-text-tertiary);
  }

  .fact-v {
    color: var(--color-text-primary);
  }

  /* ---------- templates ---------- */

  .template-strip {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .template {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /*
   * Each sheet is a diagram of one design's skeleton. The differences that
   * matter when picking are where the name sits and whether there is a hint
   * column beside the body — moderncv's classic and casual carry one, the rest
   * run full width — so those are the only things drawn. Anything more detailed
   * would be inventing output the compiler has not produced.
   */
  .sheet {
    aspect-ratio: 1 / 1.414;
    background: var(--color-paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 11%;
    display: flex;
    flex-direction: column;
    gap: 8%;
    overflow: hidden;
  }

  .sheet-head {
    display: block;
    flex: none;
  }

  .sheet-name {
    display: block;
    height: 7px;
