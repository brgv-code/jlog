                </div>

                <!-- 3. The pipeline. The rows that were already there are
                     static; the Linear row is the one that writes itself, so it
                     is the only one carrying --i and the highlight. -->
                <div class="act-panel act-list">
                  <div class="bar">
                    <span class="bar-title">Applications</span>
                    <span class="bar-tools">
                      <span class="tab on">All</span>
                      <span class="tab">Applied</span>
