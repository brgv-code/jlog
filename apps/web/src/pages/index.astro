---
/*
 * The homepage: short on purpose. One product shot, six features, the
 * tailored-CV story in one band, pricing, open source, the FAQ. Depth lives
 * on the feature pages (styles/site.css, layouts/SiteLayout.astro).
 *
 * Every claim is what the product does; the FAQ and the structured data are
 * built from one list so they cannot disagree.
 */
import SiteLayout from '../layouts/SiteLayout.astro';

/*
 * The Chrome Web Store listing. Empty until the extension is published: the
 * store assigns the URL on first upload, and a button that 404s is worse than
 * none. Set it and the install buttons appear.
 */
const STORE_URL = '';
const GITHUB_URL = 'https://github.com/brgv-code/jlog';

/* The app, as it looks with a search under way. Invented companies. */
const rows = [
  {
    co: 'Fabrikam',
    role: 'Senior Frontend Engineer',
    meta: 'Applied · 2 days ago · Greenhouse',
    status: 'applied',
    tile: 'F',
    hue: 222,
  },
  {
    co: 'Northwind',
    role: 'Product Engineer',
    meta: 'Interview · Thursday · Lever',
    status: 'interviewing',
    tile: 'N',
    hue: 18,
  },
  {
    co: 'Contoso',
    role: 'Staff Engineer, Platform',
    meta: 'Offer · today · Ashby',
    status: 'offer',
    tile: 'C',
    hue: 150,
  },
  {
    co: 'Ledgerline',
    role: 'Full-stack Engineer',
    meta: 'Applied · 1 week ago · LinkedIn',
    status: 'applied',
    tile: 'L',
    hue: 262,
  },
  {
    co: 'Brightwave',
    role: 'Frontend Engineer',
    meta: 'Saved · 1 week ago',
    status: 'saved',
    tile: 'B',
    hue: 42,
  },
];

const statusLabel: Record<string, string> = {
  saved: 'Saved',
  applied: 'Applied',
  interviewing: 'Interviewing',
  offer: 'Offer',
};

/*
 * The six things jlog does. Only Tailored CV has its own page so far; the
 * rest are anchors the nav's Product menu points at.
 */
const features = [
  {
    id: 'capture',
    chip: 'blue',
    title: 'Capture',
    body: 'Apply on LinkedIn, Greenhouse, Lever, Ashby, Wellfound or YC and the row writes itself. Anywhere else, one click reads the page.',
    icon: 'M4 13h4l2 3h4l2-3h4M4 13l2.5-7h11L20 13v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-5Z',
  },
  {
    id: 'autofill',
    chip: 'green',
    title: 'Autofill',
    body: 'Fills the empty fields of an application from your profile. Never guesses visa or salary answers, and never presses submit.',
    icon: 'M5 4h14v16H5zM8 8h8M8 12h5M8 16l2 2 4-4',
  },
  {
    id: 'tailored-cv',
    chip: 'violet',
    title: 'Tailored CV',
    body: 'A CV for each posting, built from sentences you already wrote. Every line links back to where it came from.',
    icon: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5',
    href: '/features/tailored-cv',
  },
  {
    id: 'answers',
    chip: 'pink',
    title: 'Drafted answers',
    body: '“Why do you want to work here?” gets a draft from your real experience, with the facts it used listed underneath.',
    icon: 'M5 5h14v10H9l-4 4zM9 9h6M9 12h3',
    pro: true,
  },
  {
    id: 'tracking',
    chip: 'teal',
    title: 'Tracking',
    body: 'Saved to offer in one list, with notes, follow-ups and the original posting kept next to each application.',
    icon: 'M4 6h16M4 12h16M4 18h10M18 16l2 2-2 2',
  },
  {
    id: 'insights',
    chip: 'amber',
    title: 'Home',
    body: 'Opens on what needs you: applications gone quiet, replies you are waiting on, conversations in progress.',
    icon: 'M4 19V9M10 19V5M16 19v-7M22 19H2',
  },
];

const faqs = [
  {
    q: 'Does jlog apply to jobs for me?',
    a: 'No. It records applications you make, and on Greenhouse, Lever and Ashby it fills empty fields from your profile. It never presses submit: you read the form and send it yourself.',
  },
  {
    q: 'Is the free plan really free?',
    a: 'Yes. Capture, tracking, the dashboard, form filling and CV import are free with no time limit and no card. Pro, at €9 a month, adds tailored CVs, cover letters and drafted answers.',
  },
  {
    q: 'Which job boards does it work with?',
    a: 'Applications are captured automatically on LinkedIn, Wellfound, Ashby, Greenhouse, Lever and Y Combinator’s job board. On any other page, one click reads the posting, and anything else can be added by hand.',
  },
  {
    q: 'Can the AI make up experience on my CV?',
    a: 'No. Every line is a sentence from the CV you imported or a wording you used in an earlier application. The model only chooses and orders them, and each line links back to where it came from.',
  },
  {
    q: 'Is my data sent to your server?',
    a: 'On the hosted version, yes: applications, your CV and the postings you extract are stored by jlog, and postings and CV text go to the AI provider you configured. Nothing is sold or shared with anyone else. Self-host it and nothing leaves your own Cloudflare account.',
  },
  {
    q: 'Why do I need my own AI key?',
    a: 'So you pay the provider directly, at cost, and jlog never marks it up. A whole job search usually costs under €2 in model usage. With Ollama, nothing leaves your machine.',
  },
];

/* Structured data: what the product is and what it costs, plus the FAQ. */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'jlog',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Chrome',
    description:
      'Open-source job application tracker with a Chrome extension that captures applications and builds tailored CVs from your real experience.',
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Pro', price: '9', priceCurrency: 'EUR' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<SiteLayout
  title="jlog — Job Application Tracker & Tailored CV Builder"
  description="Free, open-source job application tracker. Captures applications from LinkedIn, Greenhouse and Lever, then builds a tailored CV from your real experience."
>
  <!-- ─────────────── Hero ─────────────── -->
  <section class="hero wrap">
    <div class="hero-copy reveal">
      <h1 class="display">Job applications, <em>without the busywork.</em></h1>
      <p class="lead">
        jlog records every application you make, fills in the forms, and builds a tailored CV
        (résumé) from your real experience.
      </p>
      <div class="cta">
        <a href="/login" class="btn btn-ink">Get started for free</a>
        <a href="#features" class="btn btn-line">See how it works</a>
      </div>
    </div>
    <div class="hero-aside" aria-hidden="true">
      <svg class="hero-curve" viewBox="0 0 220 180" fill="none">
        <path d="M4 176 C 60 170, 70 60, 150 44 S 210 20, 216 4" />
        <circle cx="150" cy="44" r="3.5" />
      </svg>
      <p class="meta hero-note">From saved to offer.<br />All in one place.</p>
    </div>
  </section>

  <!-- ─────────────── The app ─────────────── -->
  <section class="wrap shot-wrap reveal">
    <figure class="frame app" aria-label="The jlog app: a list of applications and their status">
      <div class="app-side">
        <p class="app-mark">jlog</p>
        <ul>
          <li>Home</li>
          <li class="on">Applications</li>
          <li>CV</li>
          <li>Settings</li>
        </ul>
      </div>
      <div class="app-main">
        <div class="app-head">
          <p class="app-title">Applications</p>
          <p class="meta">72 in total · 9 need you</p>
        </div>
        <div class="app-tabs">
          <span class="on">All</span><span>Saved</span><span>Applied</span><span>Interviewing</span>
        </div>
        <ul class="app-rows">
          {
            rows.map((r) => (
              <li>
                <span class="tile" style={`--h:${r.hue}`}>{r.tile}</span>
                <span class="row-main">
                  <span class="row-title">
                    {r.role} <span class="row-co">· {r.co}</span>
                  </span>
                  <span class="row-meta">{r.meta}</span>
                </span>
                <span class={`pill pill-${r.status}`}>{statusLabel[r.status]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </figure>
  </section>

  <!-- ─────────────── Features ─────────────── -->
  <section class="wrap chapter" id="features">
    <h2 class="h2 reveal">Everything between the posting and the offer.</h2>
    <ul class="features">
      {
        features.map((f) => (
          <li class="card feature reveal" id={f.id}>
            <span class={`chip chip-${f.chip}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={f.icon} />
              </svg>
            </span>
            <h3 class="h3">
              {f.title}
              {f.pro && <span class="tag">Pro</span>}
            </h3>
            <p class="feature-body">{f.body}</p>
            {f.href && (
              <a class="feature-link" href={f.href}>
                Explore {f.title.toLowerCase()} →
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ─────────────── Tailored CV ─────────────── -->
  <section class="wrap">
    <div class="band band-cv reveal">
      <div class="band-copy">
        <h2 class="h2">A tailored CV that never invents experience.</h2>
        <p class="body">
          Your experience, selected for the job. Every line is a sentence you already wrote,
          and every line has a source you can open.
        </p>
        <a class="btn btn-ink" href="/features/tailored-cv">Explore tailored CV →</a>
      </div>
      <div class="band-visual" aria-hidden="true">
        <div class="sheet mini-cv">
          <p class="mini-name">Ada Lovelace</p>
          <p class="mini-role">Senior Frontend Engineer</p>
          <p class="mini-h">Experience</p>
          <span class="bar"></span>
          <p class="mini-hit">Cut p95 page load from 3.1s to 1.2s with code-splitting.</p>
          <span class="bar"></span>
          <span class="bar bar-short"></span>
        </div>
        <span class="tag tag-accent mini-src">your CV · line 8</span>
        <svg class="mini-wire" viewBox="0 0 80 40" fill="none" preserveAspectRatio="none">
          <path d="M0 30 C 30 30, 50 20, 80 20" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ─────────────── Pricing ─────────────── -->
  <section class="wrap chapter" id="pricing">
    <h2 class="h2 reveal">Tracking is free, and stays free.</h2>
    <div class="plans">
      <article class="card plan reveal">
        <p class="plan-name">Free</p>
        <p class="plan-price">€0</p>
        <p class="plan-lead">Everything that runs a search.</p>
        <ul>
          <li>Automatic capture on six job boards</li>
          <li>Application forms filled, never submitted</li>
          <li>Unlimited applications, notes and follow-ups</li>
          <li>Home and every chart behind it</li>
          <li>CV import, and the facts it reads out</li>
          <li>Self-host it on your own Cloudflare account</li>
        </ul>
        <a class="btn btn-line" href="/login">Start for free</a>
      </article>
      <article class="card plan plan-pro reveal">
        <p class="plan-name">Pro</p>
        <p class="plan-price">€9 <span>a month</span></p>
        <p class="plan-lead">Everything in Free, plus documents.</p>
        <ul>
          <li>A tailored CV for each posting</li>
          <li>A cover letter from the same facts</li>
          <li>Drafted answers, with the facts they used</li>
          <li>Six CV designs, typeset as real PDFs</li>
          <li>Every line traceable to its source</li>
        </ul>
        <a class="btn btn-ink" href="/login">Start with Pro</a>
        <p class="plan-note">
          Uses your own AI provider key, billed by your provider at cost: typically under €2 for
          a whole job search. jlog never marks it up. Cancel any time.
        </p>
      </article>
    </div>
  </section>

  <!-- ─────────────── Open source ─────────────── -->
  <section class="wrap">
    <div class="band band-oss reveal">
      <div class="band-copy">
        <h2 class="h2">Open source. Self-hostable. Your own model.</h2>
        <p class="body">
          MIT licensed, and it runs on Cloudflare's free tier. On the hosted version the
          extension records only the company, role and link on the six boards, fills forms
          without sending them anywhere, and reads a page only when you click Extract or Draft.
          <a href="/privacy">What is stored</a>, in plain words.
        </p>
        <div class="cta">
          {
            STORE_URL && (
              <a href={STORE_URL} class="btn btn-ink" target="_blank" rel="noopener noreferrer">
                Add to Chrome
              </a>
            )
          }
          <a href={GITHUB_URL} class="btn btn-line" target="_blank" rel="noopener noreferrer">
            Read the source
          </a>
        </div>
        {!STORE_URL && <p class="meta oss-note">The Chrome extension is built from source until its store listing is live.</p>}
      </div>
      <svg class="contours" viewBox="0 0 400 260" fill="none" aria-hidden="true">
        {
          [0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => (
            <path
              d={`M${-20 + i * 6} ${260 - i * 4} C ${80 + i * 10} ${200 - i * 22}, ${170 + i * 6} ${150 - i * 14}, ${420} ${40 + i * 18}`}
            />
          ))
        }
      </svg>
    </div>
  </section>

  <!-- ─────────────── FAQ ─────────────── -->
  <section class="wrap chapter faq" id="faq">
    <h2 class="h2 reveal">Questions, answered.</h2>
    <div class="faq-list reveal">
      {
        faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- ─────────────── Closer ─────────────── -->
  <section class="wrap closer reveal">
    <h2 class="display closer-title">Start with the applications you have open <em>now</em>.</h2>
    <a href="/login" class="btn btn-ink">Get started for free</a>
    <p class="meta">No card to start. Tracking stays free.</p>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</SiteLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    padding-top: clamp(4rem, 10vw, 8rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-copy {
    max-width: 44rem;
  }

  .hero .lead {
    margin-top: 1.5rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 2rem;
  }

  .hero-aside {
    position: absolute;
    right: var(--gutter);
    top: clamp(4rem, 9vw, 7rem);
    width: 220px;
  }

  .hero-curve {
    width: 100%;
    height: auto;
  }

  .hero-curve path {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .hero-curve circle {
    fill: var(--ink);
  }

  .hero-aside {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
  }

  .hero-note {
    line-height: 1.5;
    white-space: nowrap;
    align-self: flex-end;
  }

  /* ---------- The app ---------- */

  .shot-wrap {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .app {
    display: grid;
    grid-template-columns: 180px 1fr;
    min-height: 360px;
  }

  .app-side {
    border-right: 1px solid var(--rule);
    background: #fbfaf8;
    padding: 1.25rem 0.75rem;
  }

  .app-mark {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    padding: 0 0.5rem 1rem;
  }

  .app-side ul {
    list-style: none;
    display: grid;
    gap: 0.125rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .app-side li {
    padding: 0.4rem 0.625rem;
    border-radius: 7px;
  }

  .app-side li.on {
    background: var(--paper-deep);
    color: var(--ink);
    font-weight: 550;
  }

  .app-main {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .app-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .app-title {
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .app-tabs {
    display: flex;
    gap: 0.25rem;
    margin: 0.875rem 0 0.5rem;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .app-tabs span {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }

  .app-tabs .on {
    background: var(--paper-deep);
    color: var(--ink);
  }

  .app-rows {
    list-style: none;
  }

  .app-rows li {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 0.875rem;
    align-items: center;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .app-rows li:last-child {
    border-bottom: none;
  }

  .tile {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.8125rem;
    color: hsl(var(--h) 55% 35%);
    background: hsl(var(--h) 70% 94%);
  }

  .row-main {
    display: grid;
    min-width: 0;
  }

  .row-title {
    font-size: 0.875rem;
    font-weight: 550;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-co {
    font-weight: 400;
    color: var(--ink-2);
  }

  .row-meta {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .pill {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    border: 1px solid;
  }

  .pill-applied {
    color: #3150d8;
    background: #eef2fe;
    border-color: #d6defc;
  }

  .pill-interviewing {
    color: #9a4d0e;
    background: #fdf1e3;
    border-color: #f5dcc0;
  }

  .pill-offer {
    color: #2a6f44;
    background: #e8f5ec;
    border-color: #cbe7d5;
  }

  .pill-saved {
    color: var(--ink-2);
    background: var(--paper);
    border-color: var(--rule);
  }

  /* ---------- Features ---------- */

  .features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .feature {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 1.5rem;
    scroll-margin-top: 90px;
  }

  .feature .chip {
    margin-bottom: 0.5rem;
  }

  .feature .h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .feature-body {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .feature-link {
    font-size: var(--t-small);
    font-weight: 550;
    color: var(--accent-ink);
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .feature-link:hover {
    text-decoration: underline;
  }

  /* ---------- Bands ---------- */

  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 20px;
    background: var(--paper-deep);
    border: 1px solid var(--rule);
  }

  .band-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .band-copy .body a {
    color: var(--ink);
    text-underline-offset: 2px;
  }

  .band-visual {
    position: relative;
    min-height: 240px;
  }

  .mini-cv {
    position: absolute;
    left: 0;
    right: 30%;
    top: 0;
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }

  .mini-name {
    font-weight: 600;
  }

  .mini-role {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: -0.375rem;
  }

  .mini-h {
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }

  .bar {
    height: 7px;
    border-radius: 4px;
    background: var(--paper-deep);
  }

  .bar-short {
    width: 60%;
  }

  .mini-hit {
    font-size: 0.8125rem;
    line-height: 1.45;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    background: #fdf6d8;
    border: 1px solid #f1e3a4;
  }

  .mini-src {
    position: absolute;
    right: 0;
    top: 50%;
    box-shadow: var(--shadow-soft);
  }

  .mini-wire {
    position: absolute;
    left: 70%;
    top: calc(50% - 8px);
    width: calc(30% - 8.25rem);
    height: 40px;
  }

  .mini-wire path {
    stroke: var(--accent);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
  }

  .band-oss {
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
  }

  .contours {
    position: absolute;
    right: -3rem;
    bottom: -2rem;
    width: 38%;
    height: 100%;
  }

  .contours path {
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .oss-note {
    margin-top: -0.5rem;
  }

  .band-copy .cta {
    margin-top: 0.25rem;
  }

  /* ---------- Pricing ---------- */

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .plan {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 2rem;
  }

  .plan-pro {
    border-color: #cfd9fc;
    box-shadow:
      0 0 0 3px var(--accent-wash),
      var(--shadow-soft);
  }

  .plan-name {
    font-family: var(--mono);
    font-size: var(--t-meta);
    color: var(--muted);
  }

  .plan-price {
