                      </span>
                      <span class="meta">Remote — EU · Greenhouse</span>
                      <span class="pill interviewing">Interviewing</span>
                    </div>
                  </div>
                </div>

                <!-- 4 and 5. The document, then the compile that ends it. The
                     bullets compose on beat four and their citations light on
                     beat five, which is the order the app does it in: it writes
                     first and attributes after. -->
                <div class="act-panel act-paper">
                  <svg class="comet act-comet" viewBox="0 0 400 260" preserveAspectRatio="none">
                    <!-- Its own gradient rather than the hero's. A paint server
                         does resolve across two inline SVGs in one document, but
                         then this panel breaks the day the hero is edited. -->
                    <defs>
                      <linearGradient id="actCometTail" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0"></stop>
