    grid-template-columns: auto;
    gap: 0.25rem;
    max-width: 13rem;
    background: var(--bg);
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    box-shadow: var(--shadow);
  }

  .note .kicker-n {
    justify-self: start;
  }

  .note-t {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .note-b {
    font-size: 0.8125rem;
    color: var(--grey);
    line-height: 1.4;
  }

  .scene {
    position: relative;
    height: 560px;
    perspective: 2400px;
  }

  .stack {
    --gap: 28px;
    position: absolute;
    left: 50%;
    top: 54%;
    width: 440px;
    height: 280px;
    margin: -140px 0 0 -220px;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(-38deg);
  }

  .layer {
    position: absolute;
    inset: 0;
    transform: translateZ(calc(var(--i) * var(--gap)));
    text-align: left;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.08),
      -18px 26px 40px -18px rgb(0 0 0 / 0.25);
  }

  .anchor {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 0 0 3px var(--bg);
  }

  /*
   * Anchors sit on each layer's front edge: the strip that stays visible
   * under the layer above, so an arrow can only land on its own layer.
   */
  .anchor-l {
    left: 16%;
    bottom: 10px;
  }

  .anchor-r {
    right: 16%;
    bottom: 10px;
  }

  .l-body {
    padding: 0.875rem 1rem;
    display: grid;
    gap: 0.4rem;
  }

  .l-co {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--grey);
    text-transform: uppercase;
  }

  .l-title {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .l-sub {
    font-size: 0.75rem;
    color: var(--grey);
  }

  .bar {
    height: 6px;
    border-radius: 3px;
    background: var(--bg-3);
  }

  .bar-s {
    width: 60%;
  }

  .l-apply {
    justify-self: start;
    margin-top: 0.4rem;
    font-size: 0.6875rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
  }

  .field {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.6875rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .field span {
    color: var(--grey);
  }

  .field b {
    font-weight: 500;
  }

  .field i {
    font-style: normal;
    color: var(--st-offer);
  }

  .l-foot {
    font-size: 0.6875rem;
    color: var(--grey);
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.2rem;
  }

  .l-rows {
    list-style: none;
    padding: 0.5rem 0.75rem;
  }

  .l-rows li {
    display: grid;
    grid-template-columns: 1.5rem 1fr auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.55rem 0.25rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
  }

  .l-rows li:last-child {
    border-bottom: none;
  }

  .l-rows .t {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    background: var(--bg-3);
    font-weight: 600;
    font-size: 0.6875rem;
  }

  .l-rows .new {
    background: var(--bg-2);
    border-radius: 6px;
  }

  .l-cv {
    padding: 1rem 1.125rem;
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }

  .cv-name {
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
  }

  .cv-sub {
    font-size: 0.6875rem;
    color: var(--grey);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    margin-bottom: 0.25rem;
  }

  .cv-line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.6875rem;
    line-height: 1.45;
    padding: 0.3rem 0;
    border-bottom: 1px dashed var(--line-2);
  }

  /* ---------- How it works: pinned ---------- */

  .how {
    border-top: 1px solid var(--line);
  }

  .how-head {
    padding: clamp(3.5rem, 7vw, 6rem) clamp(1.25rem, 4vw, 3rem) 0;
  }

  .how-track {
    position: relative;
    height: calc(var(--steps) * 85vh + 15vh);
  }

  .how-pin {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    min-height: 520px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 280px;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
  }

  .how-index,
  .how-frame,
  .how-captions {
    position: relative;
    z-index: 1;
  }

  .how-index {
    list-style: none;
    display: grid;
    gap: 0.25rem;
    border-left: 1px solid var(--line-2);
  }

  .how-index li {
    position: relative;
    padding: 0.2rem 0 0.2rem 1rem;
    font-size: 0.9375rem;
    color: var(--grey);
    transition: color 300ms var(--ease);
  }

  .how-index li::before {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--ink);
    transform: scaleY(0);
    transition: transform 400ms var(--ease);
  }

  .how-index li.on {
    color: var(--ink);
    font-weight: 500;
  }

  .how-index li.on::before {
    transform: none;
  }

  .how-frame {
    justify-self: center;
    width: 100%;
    max-width: 540px;
    height: 380px;
    display: grid;
    grid-template-rows: auto 1fr;
    box-shadow: var(--shadow-float);
  }

  .how-panels {
    position: relative;
  }

  .panel {
    position: absolute;
    inset: 0;
    padding: 1.25rem 1.375rem;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 450ms var(--ease),
      transform 600ms var(--ease);
  }

  .panel.on {
    opacity: 1;
    transform: none;
  }

  .toast {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.625rem 0.75rem;
    max-width: 330px;
    background: var(--ink);
    color: #ededed;
    border-radius: 10px;
    font-size: 0.75rem;
    line-height: 1.35;
    box-shadow: var(--shadow-float);
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition:
      opacity 400ms var(--ease) 500ms,
      transform 600ms var(--ease) 500ms;
  }

  .toast b {
    color: #fff;
    font-weight: 600;
  }

  .toast .pill {
    color: #9dbcff;
  }

  .toast-mark {
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 6px;
    background: #fff;
    color: var(--ink);
    font-weight: 700;
  }

  .on .toast {
    opacity: 1;
    transform: none;
  }

  .p-fill .field b,
  .p-fill .field i {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 380ms steps(12) calc(250ms + var(--d) * 220ms);
  }

  .p-fill.on .field b,
  .p-fill.on .field i {
    clip-path: inset(0);
  }

  .p-fill .field {
    transition: border-color 300ms var(--ease) calc(250ms + var(--d) * 220ms);
  }

  .p-fill.on .field {
    border-color: var(--line-2);
  }

  .fill-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.5rem;
    font-size: 0.75rem;
  }

  .submit {
    padding: 0.35rem 0.75rem;
    border: 1px dashed var(--grey-2);
    border-radius: 6px;
    color: var(--grey);
  }

  .p-track .l-rows {
    padding: 0;
  }

  .p-track li:not(.new) {
    transform: translateY(-100%);
    transition: transform 650ms var(--ease) 250ms;
  }

  .p-track .new {
    opacity: 0;
    transition: opacity 400ms var(--ease) 650ms;
  }

  .p-track.on li:not(.new) {
    transform: none;
  }

  .p-track.on .new {
    opacity: 1;
  }

  .p-cv .cv-line {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 400ms var(--ease) calc(300ms + var(--d) * 250ms),
      transform 500ms var(--ease) calc(300ms + var(--d) * 250ms);
  }

  .p-cv .cv-line .tag {
    opacity: 0;
    transition: opacity 300ms var(--ease) calc(650ms + var(--d) * 250ms);
  }

  .p-cv.on .cv-line,
  .p-cv.on .cv-line .tag {
    opacity: 1;
    transform: none;
  }

  .how-captions {
    display: grid;
  }

  .how-cap {
    grid-area: 1 / 1;
    display: grid;
    gap: 0.625rem;
    align-content: start;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 400ms var(--ease),
      transform 500ms var(--ease);
  }

  .how-cap.on {
    opacity: 1;
    transform: none;
  }

  .how-cap-t {
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .how-cap-b {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .how *,
    .how *::before {
      transition: none !important;
    }
  }

  /* ---------- Features: a ruled grid, cells share borders ---------- */

  .features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .feature {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 2rem clamp(1.25rem, 3vw, 2rem) 2.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 80px;
    transition: background 200ms var(--ease);
  }

  .feature:hover {
    background: var(--bg-2);
  }

  .feature:nth-child(3n) {
    border-right: none;
  }

  .feature:nth-last-child(-n + 3) {
    border-bottom: none;
  }

  .feature .h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .feature-body {
    font-size: 0.9375rem;
    color: var(--ink-2);
  }

  .feature-link {
    font-size: var(--t-small);
    font-weight: 500;
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .feature-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Company first, role under it: rows that stay one tidy height on a phone. */
  .co-r {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .co-r b {
    font-weight: 600;
  }

  .co-r span {
    color: var(--grey);
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- Feature minis: a little of the real UI, moving ---------- */

  .mini {
    position: relative;
    height: 148px;
    margin-bottom: 0.75rem;
    padding: 0.875rem;
    border-radius: 10px;
    background: var(--bg-2);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
    display: grid;
    align-content: start;
    gap: 0.4rem;
    font-size: 0.75rem;
  }

  .mini .t {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 5px;
    background: var(--bg-3);
    font-weight: 600;
    font-size: 0.625rem;
  }

  /* capture */
  .mini-bar {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: var(--grey);
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mini-h {
    font-weight: 600;
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  .mini-apply {
    justify-self: start;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    background: var(--ink);
    color: #fff;
    font-size: 0.6875rem;
  }

  .mini-toast {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.55rem 0.3rem 0.3rem;
    border-radius: 8px;
    background: var(--ink);
    color: #fff;
    font-size: 0.6875rem;
    box-shadow: var(--shadow-float);
  }

  .mini-toast .toast-mark {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
    font-weight: 700;
  }

  /* autofill */
  .mini-field {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mini-field span {
    color: var(--grey);
  }

  .mini-field b {
    font-weight: 500;
    white-space: nowrap;
  }

  /* tailored cv */
  .mini-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .mini-line span {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--line-2);
  }

  .mini-line em {
    font-style: normal;
  }

  /* drafted answers */
  .mini-q {
    color: var(--grey);
  }

  .mini-draft {
    padding: 0.45rem 0.55rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    line-height: 1.45;
  }

  .mini-draft span {
    display: inline;
  }

  .mini-facts {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .mini-facts em {
    font-style: normal;
  }

  /* tracking */
  .mini-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .dim-row {
    opacity: 0.55;
  }

  .mini-status {
    display: grid;
    height: 1.2rem;
    overflow: hidden;
  }

  .mini-status .pill {
    grid-area: 1 / 1;
    justify-self: end;
  }

  /* home */
  .mini-alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.55rem;
    border-radius: 6px;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--grey);
  }

  .mini-alert b {
    margin-left: auto;
    color: var(--ink);
    font-weight: 500;
  }

  .ping {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--st-interview);
    flex: none;
  }

  .ping-2 {
    background: var(--st-applied);
  }

  .ping-3 {
    background: var(--st-offer);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mini-toast {
      animation: toast 4.5s var(--ease) infinite;
    }

    .mini-field b {
      animation: type 5s steps(14) infinite;
      animation-delay: calc(var(--d) * 0.45s);
    }

    .mini-line {
      animation: rise 5s var(--ease) infinite;
      animation-delay: calc(var(--d) * 0.3s);
    }

    .mini-draft span {
      animation: type 6s steps(40) infinite;
    }

    .mini-status .pill {
      animation: status 8s infinite;
    }

    .mini-status .pill:nth-child(2) {
      animation-delay: -6s;
    }

    .mini-status .pill:nth-child(3) {
      animation-delay: -4s;
    }

    .mini-status .pill:nth-child(4) {
      animation-delay: -2s;
    }

    .ping::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: inherit;
      animation: ping 2s ease-out infinite;
    }

    .ping-2::after {
      animation-delay: 0.6s;
    }

    .ping-3::after {
      animation-delay: 1.2s;
    }
  }

  @keyframes toast {
    0%,
    15% {
      opacity: 0;
      transform: translateY(10px);
    }
    25%,
    85% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes type {
    0% {
      clip-path: inset(0 100% 0 0);
    }
    35%,
    100% {
      clip-path: inset(0);
    }
  }

  @keyframes rise {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    12%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* Each pill owns a quarter of the loop: in, hold, out. */
  @keyframes status {
    0% {
      opacity: 0;
      transform: translateY(100%);
    }
    4%,
    22% {
      opacity: 1;
      transform: none;
    }
    26%,
    100% {
      opacity: 0;
      transform: translateY(-100%);
    }
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mini-status .pill:not(:nth-child(2)) {
      display: none;
    }
  }

  /* ---------- Tailored CV trace ---------- */

  .trace-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    background: var(--bg-2);
  }

  .trace-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .trace {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem;
  }

  .trace-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .trace-wires :global(path) {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.25;
  }

  .trace-wires :global(.pulse) {
    fill: var(--signal);
  }

  .trace-col {
    display: grid;
    gap: 0.625rem;
    align-content: start;
  }

  .trace-item {
    font-size: 0.8125rem;
    line-height: 1.45;
    padding: 0.625rem 0.75rem;
    background: var(--bg);
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .trace-item.muted,
  .trace-item.gap {
    color: var(--grey-2);
    background: transparent;
    box-shadow: 0 0 0 1px var(--line-2);
  }

  .trace-item.gap {
    border: 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  /* ---------- Pricing ---------- */

  .pricing-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: 2rem;
    align-items: end;
  }

  .receipt {
    display: grid;
    gap: 0.125rem;
    padding: 1.125rem 1.25rem 1rem;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--bg-2);
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-family: var(--mono);
    font-size: 0.75rem;
    /* A torn bottom edge. */
    mask: linear-gradient(#000, #000) top / 100% calc(100% - 6px) no-repeat,
      radial-gradient(circle at 6px 0, transparent 4px, #000 4.5px) bottom / 12px 6px repeat-x;
  }

  .receipt-h {
    margin-bottom: 0.5rem;
  }

  .receipt-l {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px dashed var(--line-2);
  }

  .receipt-l span {
    color: var(--ink-2);
  }

  .receipt-l em {
    display: block;
    font-style: normal;
    color: var(--grey);
    font-size: 0.6875rem;
  }

  .receipt-l b {
    font-weight: 500;
    white-space: nowrap;
  }

  .receipt-t {
    border-bottom: 0;
    border-top: 1px solid var(--ink);
    margin-top: 0.25rem;
    padding-bottom: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
