---
/*
 * The homepage.
 *
 * One idea above the fold: applications arrive from anywhere and are wired
 * into one list. Below: how it works (pinned), the six features, then the
 * four layers of one application as an exploded 3D stack that separates as
 * you scroll, each layer labelled by an arrow, leading into the tailored-CV
 * trace (the top layer). Then pricing, open source, FAQ.
 *
 * Every claim is what the product does. Companies and people are invented.
 * The FAQ and the structured data are built from one list.
 */
import { APPLICATIONS, STATUS_LABEL, shortRole } from '../data/demo';
import SiteLayout from '../layouts/SiteLayout.astro';

/*
 * The Chrome Web Store listing. Empty until the extension is published: the
 * store assigns the URL on first upload, and a button that 404s is worse than
 * none. Set it and the install buttons appear.
 */
const STORE_URL = '';
const GITHUB_URL = 'https://github.com/brgv-code/jlog';

/*
 * Where applications come from. Every path the product really has: six boards
 * are captured as you apply, any other page is one click, and anything else
 * is added by hand.
 */
const SOURCES = [
  { name: 'Job boards', note: 'LinkedIn, Greenhouse, Lever, Ashby…', how: 'auto' },
  { name: 'Company sites', note: 'careers pages and their portals', how: '1 click' },
  { name: 'Any job page', note: 'a posting anywhere on the web', how: '1 click' },
  { name: 'Referrals', note: 'a friend, a recruiter, an event', how: 'by hand' },
];

/* The four layers, bottom to top, and what each arrow says about it. */
const notes = [
  { n: '01', side: 'left', title: 'Captured', body: 'from the board you applied on' },
  { n: '02', side: 'right', title: 'Filled', body: 'from your profile, never submitted' },
  { n: '03', side: 'left', title: 'Tracked', body: 'from saved to offer, in one list' },
  { n: '04', side: 'right', title: 'Tailored', body: 'a CV built from your own lines' },
];

/* The pinned walkthrough: one step per screen of scroll. */
const steps = [
  {
    n: '01',
    title: 'Capture',
    bar: 'boards.greenhouse.io/fabrikam',
    head: 'Apply as usual. The row writes itself.',
    body: 'On six boards jlog notices the application and saves the company, role and link. Anywhere else, one click reads the page.',
  },
  {
    n: '02',
    title: 'Autofill',
    bar: 'Fabrikam · application form',
    head: 'The form, filled from your profile.',
    body: 'Name, contact details, work authorisation and notice period go in. Experience stays yours to write, and submit stays yours to press.',
  },
  {
    n: '03',
    title: 'Track',
    bar: 'jlog · Applications',
    head: 'Saved to offer, in one list.',
    body: 'Every application with its status, notes, follow-ups and the original posting, so nothing goes quiet without you noticing.',
  },
  {
    n: '04',
    title: 'Tailor',
    bar: 'jlog · CV for Fabrikam',
    head: 'A CV built from your own lines.',
    body: 'jlog picks the sentences from your CV that answer this posting. Each one says where it came from, and none are made up.',
  },
];

/* The closing feed: Ada's search, arriving from every kind of source. */
const feed = APPLICATIONS;

const features = [
  {
    n: '01',
    id: 'capture',
    title: 'Capture',
    body: 'Apply on LinkedIn, Greenhouse, Lever, Ashby, Wellfound or YC and the row writes itself. Anywhere else, one click reads the page.',
    href: '/features/job-capture',
  },
  {
    n: '02',
    id: 'autofill',
    title: 'Autofill',
    body: 'Fills the empty fields of an application from your profile. Never guesses visa or salary answers, and never presses submit.',
    href: '/features/autofill',
  },
  {
    n: '03',
    id: 'tailored-cv',
    title: 'Tailored CV',
    body: 'A CV for each posting, built from sentences you already wrote. Every line links back to where it came from.',
    href: '/features/tailored-cv',
  },
  {
    n: '04',
    id: 'answers',
    title: 'Drafted answers',
    body: '“Why do you want to work here?” gets a draft from your real experience, with the facts it used listed underneath.',
    pro: true,
  },
  {
    n: '05',
    id: 'tracking',
    title: 'Tracking',
    body: 'Saved to offer in one list, with notes, follow-ups and the original posting kept next to each application.',
    href: '/features/tracking',
  },
  {
    n: '06',
    id: 'home',
    title: 'Home',
    body: 'Opens on what needs you: applications gone quiet, replies you are waiting on, conversations in progress.',
  },
];

const faqs = [
  {
    q: 'Does jlog apply to jobs for me?',
    a: 'No. It records applications you make, and on Greenhouse, Lever and Ashby it fills empty fields from your profile. It never presses submit: you read the form and send it yourself.',
  },
  {
    q: 'Is the free plan really free?',
    a: 'Yes. Capture, tracking, the dashboard, form filling and CV import are free with no time limit and no card. Pro, at €9 a month, adds tailored CVs, cover letters and drafted answers.',
  },
  {
    q: 'Which job boards does it work with?',
    a: 'Applications are captured automatically on LinkedIn, Wellfound, Ashby, Greenhouse, Lever and Y Combinator’s job board. On any other page, one click reads the posting, and anything else can be added by hand.',
  },
  {
    q: 'Can the AI make up experience on my CV?',
    a: 'No. Every line is a sentence from the CV you imported or a wording you used in an earlier application. The model only chooses and orders them, and each line links back to where it came from.',
  },
  {
    q: 'Is my data sent to your server?',
    a: 'On the hosted version, yes: applications, your CV and the postings you extract are stored by jlog, and postings and CV text go to the AI provider you configured. Nothing is sold or shared with anyone else. Self-host it and nothing leaves your own Cloudflare account.',
  },
  {
    q: 'Why do I need my own AI key?',
    a: 'So you pay the provider directly, at cost, and jlog never marks it up. A whole job search usually costs under €2 in model usage. With Ollama, nothing leaves your machine.',
  },
];

/* Structured data: what the product is and what it costs, plus the FAQ. */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'jlog',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Chrome',
    description:
      'Open-source job application tracker with a Chrome extension that captures applications and builds tailored CVs from your real experience.',
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Pro', price: '9', priceCurrency: 'EUR' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<SiteLayout
  title="jlog — Job Application Tracker & Tailored CV Builder"
  description="Free, open-source job application tracker. Captures applications from LinkedIn, Greenhouse and Lever, then builds a tailored CV from your real experience."
>
  <div class="rail">
    <!-- ─────────────── Hero ─────────────── -->
    <section class="row hero">
      <div class="hero-top">
        <a class="announce" href="/features/autofill">
          <span class="tag">New</span> Autofill on Greenhouse, Lever and Ashby <span aria-hidden="true">→</span>
        </a>
        <h1 class="display hero-title">
          Job applications,<br /><span class="dim">without the busywork.</span>
        </h1>
        <p class="lead hero-lead">
          jlog records every application you make, fills in the forms, and builds a tailored CV
          (résumé) from your real experience.
        </p>
        <div class="cta">
          <a href="/login" class="btn btn-ink">Get started for free</a>
          <a href="/demo" class="btn btn-line">Try a demo account</a>
          <a href="#how" class="btn btn-line">See how it works</a>
        </div>
        <p class="meta cta-note">The demo needs no sign-up: a sample search with 200 applications.</p>
      </div>

      <!--
        Intake, drawn as a wiring diagram: each source has a wire that
        runs down to a shared bus and into jlog. Small pulses travel the
        wires. Routed by the script, with square
        corners softened, to match the page grid.
      -->
      <div class="intake" data-intake>
        <p class="meta intake-label">From anywhere you apply</p>
        <ul class="intake-boards">
          {
            SOURCES.map((src) => (
              <li data-src>
                <span class="src-how">{src.how}</span>
                <b>{src.name}</b>
                <span class="src-note">{src.note}</span>
              </li>
            ))
          }
        </ul>
        <svg class="intake-wires" data-wires aria-hidden="true"></svg>
        <p class="intake-node" data-sink aria-hidden="true">
          <span class="intake-mark">j</span>
          <span>one list</span>
        </p>
      </div>
    </section>


    <!-- ─────────────── How it works ─────────────── -->
    <!--
      Pinned while you scroll past it. The index on the left marks the step,
      the frame in the middle plays it, the caption on the right explains it.
      A wide soft stroke behind draws itself along with the scroll.
    -->
    <section class="how" id="how">
      <div class="how-head">
        <div class="kicker"><span class="kicker-n">∗</span><span class="meta">How it works</span></div>
        <h2 class="h2">One application,<br /><span class="dim">four things done for you.</span></h2>
      </div>
      <div class="how-track" data-how style={`--steps:${steps.length}`}>
        <div class="how-pin">

          <ol class="how-index" aria-hidden="true">
            {steps.map((s, i) => <li data-how-i={i}>{s.title}</li>)}
          </ol>

          <div class="how-frame frame" aria-hidden="true">
            <p class="frame-bar" data-how-bar>{steps[0]?.bar}</p>
            <div class="how-panels">
              <!-- 01 · capture: the posting, and a toast that says it was saved -->
              <div class="panel p-capture" data-how-p="0">
                <p class="l-co">Fabrikam</p>
                <p class="l-title">Senior Frontend Engineer, Payments</p>
                <p class="l-sub">Berlin or remote (EU) · €80,000 to €95,000</p>
                <span class="bar"></span><span class="bar"></span><span class="bar bar-s"></span>
                <div class="toast">
                  <span class="toast-mark">j</span>
                  <span><b>Saved to jlog</b><br />Fabrikam · Senior Frontend Engineer</span>
                  <span class="pill pill-applied">Applied</span>
                </div>
              </div>

              <!-- 02 · autofill: fields fill one by one, submit stays untouched -->
              <div class="panel p-fill" data-how-p="1">
                {
                  [
                    ['First name', 'Ada'],
                    ['Last name', 'Lovelace'],
                    ['Email', 'ada.lovelace@example.com'],
                    ['Phone', '+1 202 555 0142'],
                    ['Authorised to work in Germany?', 'Yes'],
                    ['Notice period', 'One month'],
                  ].map(([k, v], i) => (
                    <div class="field" style={`--d:${i}`}>
                      <span>{k}</span>
                      <b>{v}</b>
                      <i>✓</i>
                    </div>
                  ))
                }
                <div class="fill-foot">
                  <span class="tag">Fill with jlog</span>
                  <span class="submit">Submit application</span>
                </div>
              </div>

              <!-- 03 · track: the new row lands at the top of the list -->
              <div class="panel p-track" data-how-p="2">
                <ul class="l-rows">
                  <li class="new"><span class="t">F</span><span class="co-r"><b>Fabrikam</b><span>Senior Frontend Engineer</span></span><span class="pill pill-applied">Applied</span></li>
                  <li><span class="t">N</span><span class="co-r"><b>Northwind</b><span>Senior Frontend Engineer</span></span><span class="pill pill-interviewing">Interview</span></li>
                  <li><span class="t">C</span><span class="co-r"><b>Contoso</b><span>Senior Frontend Engineer</span></span><span class="pill pill-offer">Offer</span></li>
                  <li><span class="t">W</span><span class="co-r"><b>Woodgrove</b><span>Senior Frontend Engineer</span></span><span class="pill pill-saved">Saved</span></li>
                  <li><span class="t">L</span><span class="co-r"><b>Litware</b><span>Senior Software Engineer</span></span><span class="pill pill-interviewing">Interview</span></li>
                </ul>
              </div>

              <!-- 04 · tailor: lines arrive, each with the place it came from -->
              <div class="panel p-cv" data-how-p="3">
                <p class="cv-name">Ada Lovelace</p>
                <p class="cv-sub">Senior Frontend Engineer · for Fabrikam</p>
                <div class="cv-line" style="--d:0"><span>Led the move of the checkout from jQuery to React without a feature freeze.</span><span class="tag tag-signal">CV line 7</span></div>
                <div class="cv-line" style="--d:1"><span>Cut p95 page load from 3.1s to 1.2s with code-splitting.</span><span class="tag tag-signal">CV line 8</span></div>
                <div class="cv-line" style="--d:2"><span>Owned the component library five product teams build on.</span><span class="tag">sent to Contoso</span></div>
              </div>
            </div>
          </div>

          <div class="how-captions">
            {
              steps.map((s, i) => (
                <div class="how-cap" data-how-c={i} data-bar={s.bar}>
                  <p class="meta">{s.n} · {s.title}</p>
                  <h3 class="how-cap-t">{s.head}</h3>
                  <p class="how-cap-b">{s.body}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── Features ─────────────── -->
    <section class="row" id="features">
      <div class="kicker"><span class="kicker-n">∗</span><span class="meta">Product</span></div>
      <h2 class="h2">Everything between the posting<br /><span class="dim">and the offer.</span></h2>
    </section>
    <ul class="features">
      {
        features.map((f) => (
          <li class="feature reveal" id={f.id}>
            <div class={`mini mini-${f.id}`} aria-hidden="true">
              {f.id === 'capture' && (
                <>
                  <p class="mini-bar">jobs.ashbyhq.com/litware</p>
                  <p class="mini-h">Senior Software Engineer, Frontend</p>
                  <span class="mini-apply">Submit application</span>
                  <p class="mini-toast"><span class="toast-mark">j</span> Saved · Litware</p>
                </>
              )}
              {f.id === 'autofill' && (
                <>
                  {[
                    ['Name', 'Ada Lovelace'],
                    ['Email', 'ada.lovelace@example.com'],
                    ['Notice period', 'One month'],
                  ].map(([k, v], i) => (
                    <p class="mini-field" style={`--d:${i}`}>
                      <span>{k}</span>
                      <b>{v}</b>
                    </p>
                  ))}
                </>
              )}
              {f.id === 'tailored-cv' && (
                <>
                  <p class="mini-line" style="--d:0"><span></span><em class="tag tag-signal">CV line 7</em></p>
                  <p class="mini-line" style="--d:1"><span></span><em class="tag tag-signal">CV line 8</em></p>
                  <p class="mini-line" style="--d:2"><span></span><em class="tag">sent to Contoso</em></p>
                </>
              )}
              {f.id === 'answers' && (
                <>
                  <p class="mini-q">Why do you want to work here?</p>
                  <p class="mini-draft"><span>Your checkout rewrite is the problem I solved at Ledgerline</span></p>
                  <p class="mini-facts"><em class="tag">fact · Ledgerline</em><em class="tag">fact · React</em></p>
                </>
              )}
              {f.id === 'tracking' && (
                <>
                  <p class="mini-row">
                    <span class="t">F</span>
                    <span>Fabrikam</span>
                    <span class="mini-status">
                      <span class="pill pill-saved">Saved</span>
                      <span class="pill pill-applied">Applied</span>
                      <span class="pill pill-interviewing">Interview</span>
                      <span class="pill pill-offer">Offer</span>
                    </span>
                  </p>
                  <p class="mini-row dim-row"><span class="t">N</span><span>Northwind</span><span class="pill pill-interviewing">Interview</span></p>
                  <p class="mini-row dim-row"><span class="t">W</span><span>Woodgrove</span><span class="pill pill-saved">Saved</span></p>
                </>
              )}
              {f.id === 'home' && (
                <>
                  <p class="mini-alert"><span class="ping"></span> Ghosted <b>Tailspin · 15 days</b></p>
                  <p class="mini-alert"><span class="ping ping-2"></span> Awaiting reply <b>Fabrikam · today</b></p>
                  <p class="mini-alert"><span class="ping ping-3"></span> In interview <b>Northwind, Litware</b></p>
                </>
              )}
            </div>
            <span class="meta feature-n">{f.n}</span>
            <h3 class="h3">
              {f.title}
              {f.pro && <span class="tag">Pro</span>}
            </h3>
            <p class="feature-body">{f.body}</p>
            {f.href ? (
              <a class="feature-link" href={f.href}>
                Explore <span aria-hidden="true">→</span>
              </a>
            ) : null}
          </li>
        ))
      }
    </ul>

    <!-- ─────────────── The stack ─────────────── -->
    <section class="row stack-row" id="layers">
      <div class="stack-head">
        <div class="kicker"><span class="kicker-n">∗</span><span class="meta">How it fits together</span></div>
        <h2 class="h2">Four layers,<br /><span class="dim">and your CV on top.</span></h2>
        <p class="body">
          The posting jlog captured tells it what the role asks for. Your profile filled the
          form. The list knows where the application stands. And the CV on top is built only
          from lines you already wrote.
        </p>
      </div>

      <!--
        The exploded stack. Four layers of real UI, bottom to top: the posting,
        the form, the record, the CV. They start almost flat and separate as the
        page scrolls; each carries an anchor the arrows are drawn to.
      -->
      <div class="stage" data-stage aria-label="How one application moves through jlog: captured, filled, tracked, tailored">
        <svg class="arrows" data-arrows aria-hidden="true">
          <defs>
            <marker id="tip" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M1 1 L8 5 L1 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </marker>
          </defs>
        </svg>

        <ol class="notes notes-left">
          {
            [notes[2], notes[0]].map((note) => note && (
              <li class="note" data-note={note.n} style={`--o:${Number(note.n)}`}>
                <span class="kicker-n">{note.n}</span>
                <span class="note-t">{note.title}</span>
                <span class="note-b">{note.body}</span>
              </li>
            ))
          }
        </ol>

        <div class="scene" aria-hidden="true">
          <div class="stack" data-stack>
            <!-- 01 · the posting -->
            <div class="layer frame l-post" style="--i:0">
              <p class="frame-bar">boards.greenhouse.io/fabrikam</p>
              <div class="l-body">
                <p class="l-co">Fabrikam</p>
                <p class="l-title">Senior Frontend Engineer, Payments</p>
                <p class="l-sub">Berlin or remote (EU) · Full time</p>
                <span class="bar"></span><span class="bar"></span><span class="bar bar-s"></span>
                <span class="l-apply">Apply for this job</span>
              </div>
              <span class="anchor anchor-l" data-anchor="01"></span>
            </div>

            <!-- 02 · the form, filled -->
            <div class="layer frame l-form" style="--i:1">
              <p class="frame-bar">Fabrikam · application</p>
              <div class="l-body">
                <div class="field"><span>First name</span><b>Ada</b><i>✓</i></div>
                <div class="field"><span>Email</span><b>ada.lovelace@example.com</b><i>✓</i></div>
                <div class="field"><span>Phone</span><b>+1 202 555 0142</b><i>✓</i></div>
                <div class="field"><span>Authorised to work in Germany?</span><b>Yes</b><i>✓</i></div>
                <p class="l-foot"><span class="tag">Fill with jlog</span> 9 fields filled · submit is yours</p>
              </div>
              <span class="anchor anchor-r" data-anchor="02"></span>
            </div>

            <!-- 03 · the record -->
            <div class="layer frame l-list" style="--i:2">
              <p class="frame-bar">jlog · Applications</p>
              <ul class="l-rows">
                <li class="new"><span class="t">F</span><span>Senior Frontend Engineer · Fabrikam</span><span class="pill pill-applied">Applied</span></li>
                <li><span class="t">N</span><span>Senior Frontend Engineer · Northwind</span><span class="pill pill-interviewing">Interview</span></li>
                <li><span class="t">C</span><span>Senior Frontend Engineer · Contoso</span><span class="pill pill-offer">Offer</span></li>
                <li><span class="t">W</span><span>Senior Frontend Engineer · Woodgrove</span><span class="pill pill-saved">Saved</span></li>
              </ul>
              <span class="anchor anchor-l" data-anchor="03"></span>
            </div>

            <!-- 04 · the tailored CV -->
            <div class="layer sheet l-cv" style="--i:3">
              <p class="cv-name">Ada Lovelace</p>
              <p class="cv-sub">Senior Frontend Engineer · for Fabrikam</p>
              <div class="cv-line"><span>Led the move of the checkout from jQuery to React without a feature freeze.</span><span class="tag tag-signal">line 7</span></div>
              <div class="cv-line"><span>Cut p95 page load from 3.1s to 1.2s with code-splitting.</span><span class="tag tag-signal">line 8</span></div>
              <div class="cv-line"><span>Owned the component library five product teams build on.</span><span class="tag">earlier</span></div>
              <span class="anchor anchor-r" data-anchor="04"></span>
            </div>
          </div>
        </div>

        <ol class="notes notes-right">
          {
            [notes[3], notes[1]].map((note) => note && (
              <li class="note" data-note={note.n} style={`--o:${Number(note.n)}`}>
                <span class="kicker-n">{note.n}</span>
                <span class="note-t">{note.title}</span>
                <span class="note-b">{note.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ─────────────── Tailored CV ─────────────── -->
    <section class="row trace-row">
      <div class="trace-copy">
        <div class="kicker"><span class="kicker-n">03</span><span class="meta">Tailored CV</span></div>
        <h2 class="h2">A CV that never<br /><span class="dim">invents experience.</span></h2>
        <p class="body">
          Every line on a tailored CV is a sentence from the CV you imported, or a wording you
          already sent. The model chooses and orders them. It does not write new ones.
        </p>
        <a class="btn btn-line" href="/features/tailored-cv">How it works <span aria-hidden="true">→</span></a>
      </div>
      <div class="trace" data-trace aria-hidden="true">
        <svg class="trace-wires" data-trace-wires></svg>
        <div class="trace-col">
          <p class="meta">Your CV</p>
          <p class="trace-item" data-t="a">07 · Led the move of the checkout from jQuery to React.</p>
          <p class="trace-item" data-t="b">08 · Cut p95 page load from 3.1s to 1.2s.</p>
          <p class="trace-item muted">10 · Mentored three junior engineers.</p>
        </div>
        <div class="trace-col">
          <p class="meta">For Fabrikam</p>
          <p class="trace-item out" data-t="a2">Led the move of the checkout from jQuery to React.</p>
          <p class="trace-item out" data-t="b2">Cut p95 page load from 3.1s to 1.2s.</p>
          <p class="trace-item gap">Not asked for: left out.</p>
        </div>
      </div>
    </section>

    <!-- ─────────────── Pricing ─────────────── -->
    <section class="row pricing-head" id="pricing">
      <div>
        <div class="kicker"><span class="kicker-n">€</span><span class="meta">Pricing</span></div>
        <h2 class="h2">Tracking is free,<br /><span class="dim">and stays free.</span></h2>
      </div>
      <!-- What a whole search costs on Pro, itemised like a receipt. -->
      <div class="receipt reveal" aria-label="A typical job search on Pro: €9 a month for jlog, and under €2 of model usage billed by your AI provider.">
        <p class="meta receipt-h">A typical search on Pro</p>
