<script>
  /*
   * The stack separates as the hero scrolls through the viewport, and the
   * arrows are redrawn to follow each layer's anchor. Reduced motion gets the
   * stack already open and still.
   */
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  const svg = document.querySelector<SVGSVGElement>('[data-arrows]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const NS = 'http://www.w3.org/2000/svg';

  /* A small square that travels a wire, then rests at its end for a beat. */
  function pulse(svg: SVGSVGElement, pathId: string, delay: number, dur: number) {
    if (reduce) return;
    const dot = document.createElementNS(NS, 'rect');
    dot.setAttribute('class', 'pulse');
    dot.setAttribute('x', '-2.5');
    dot.setAttribute('y', '-2.5');
    dot.setAttribute('width', '5');
    dot.setAttribute('height', '5');
    const motion = document.createElementNS(NS, 'animateMotion');
    motion.setAttribute('dur', `${dur}s`);
    motion.setAttribute('begin', `-${delay % dur}s`);
    motion.setAttribute('repeatCount', 'indefinite');
    motion.setAttribute('keyPoints', '0;1;1');
    motion.setAttribute('keyTimes', '0;0.55;1');
    motion.setAttribute('calcMode', 'linear');
    const mpath = document.createElementNS(NS, 'mpath');
    mpath.setAttribute('href', `#${pathId}`);
    motion.appendChild(mpath);
    dot.appendChild(motion);
    svg.appendChild(dot);
  }

  function drawArrows() {
    if (!stage || !svg) return;
    const box = stage.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    for (const old of svg.querySelectorAll('path.arrow')) old.remove();
    if (window.innerWidth < 1000) return;
    for (const note of stage.querySelectorAll<HTMLElement>('[data-note]')) {
      const id = note.dataset.note;
      const anchor = stage.querySelector<HTMLElement>(`[data-anchor="${id}"]`);
      if (!anchor) continue;
      const n = note.getBoundingClientRect();
      const a = anchor.getBoundingClientRect();
      const left = note.closest('.notes-left') !== null;
      const x1 = (left ? n.right + 10 : n.left - 10) - box.left;
      const y1 = n.top + 12 - box.top;
      const x2 = a.left + a.width / 2 - box.left;
      const y2 = a.top + a.height / 2 - box.top;
      const bend = (x2 - x1) * 0.55;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('class', 'arrow');
      path.setAttribute('d', `M${x1},${y1} C${x1 + bend},${y1 - 24} ${x2 - bend * 0.2},${y2 - 60} ${x2},${y2}`);
      path.setAttribute('marker-end', 'url(#tip)');
      svg.appendChild(path);
    }
  }

  function update() {
    if (!stage || !stack) return;
    const r = stage.getBoundingClientRect();
    const vh = window.innerHeight;
    // 0 when the stage's top reaches the bottom of the screen, 1 at the middle.
    const p = reduce ? 1 : Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.9)));
    const eased = 1 - (1 - p) ** 3;
    stack.style.setProperty('--gap', `${28 + eased * 78}px`);
    drawArrows();
  }

  let raf = 0;
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(update);
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  document.fonts?.ready.then(schedule);
  update();

  /* The tailored-CV trace: two wires from a CV line to where it lands. */
  const trace = document.querySelector<HTMLElement>('[data-trace]');
  const wires = document.querySelector<SVGSVGElement>('[data-trace-wires]');
  function drawTrace() {
    if (!trace || !wires) return;
    const box = trace.getBoundingClientRect();
    wires.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    wires.replaceChildren();
    for (const [from, to] of [
      ['a', 'a2'],
      ['b', 'b2'],
    ]) {
      const f = trace.querySelector(`[data-t="${from}"]`)?.getBoundingClientRect();
      const t = trace.querySelector(`[data-t="${to}"]`)?.getBoundingClientRect();
      if (!f || !t) continue;
      const x1 = f.right - box.left;
      const y1 = f.top + f.height / 2 - box.top;
      const x2 = t.left - box.left;
      const y2 = t.top + t.height / 2 - box.top;
      const m = (x1 + x2) / 2;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('id', `trace-${from}`);
      path.setAttribute('d', `M${x1},${y1} C${m},${y1} ${m},${y2} ${x2},${y2}`);
      wires.appendChild(path);
      pulse(wires, `trace-${from}`, from === 'a' ? 0 : 1.1, 2.2);
    }
  }
  window.addEventListener('resize', drawTrace);
  document.fonts?.ready.then(drawTrace);
  drawTrace();

  /*
   * Intake wiring. Each source's wire drops to a shared bus, runs along it to
   * the centre and down into jlog; the corners are square with a small
   * radius, like the page grid. A pulse travels each wire, staggered.
   */
  const intake = document.querySelector<HTMLElement>('[data-intake]');
  const wiresSvg = document.querySelector<SVGSVGElement>('[data-wires]');
  function wire() {
    const sink = intake?.querySelector<HTMLElement>('[data-sink]');
    if (!intake || !wiresSvg || !sink) return;
    const box = intake.getBoundingClientRect();
    wiresSvg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    wiresSvg.replaceChildren();
    if (window.innerWidth < 720) return;
    const s = sink.getBoundingClientRect();
    const cx = s.left + s.width / 2 - box.left;
    const y2 = s.top - box.top;
    const R = 8;
    const sources = [...intake.querySelectorAll<HTMLElement>('[data-src]')];
    const first = sources[0]?.getBoundingClientRect();
    if (!first) return;
    const bus = (first.bottom - box.top + y2) / 2;
    sources.forEach((src, i) => {
      const r = src.getBoundingClientRect();
      const x = r.left + r.width / 2 - box.left;
      const y1 = r.bottom - box.top;
      const dir = Math.sign(cx - x);
      const d =
        Math.abs(cx - x) < 2 * R
          ? `M${x},${y1} V${y2}`
          : `M${x},${y1} V${bus - R} Q${x},${bus} ${x + dir * R},${bus} H${cx - dir * R} Q${cx},${bus} ${cx},${bus + R} V${y2}`;
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('id', `wire-${i}`);
      path.setAttribute('d', d);
      wiresSvg.appendChild(path);
      pulse(wiresSvg, `wire-${i}`, i * 0.83, 2.6);
    });
  }
  if (intake) new ResizeObserver(wire).observe(intake);
  document.fonts?.ready.then(wire);

  /*
   * The self-hosting diagram: elbow wires from the extension and the web app
   * into the API, and from the API out to the data and the model.
   */
  const arch = document.querySelector<HTMLElement>('[data-arch]');
  const archSvg = document.querySelector<SVGSVGElement>('[data-arch-wires]');
  function elbow(x1: number, y1: number, x2: number, y2: number) {
    const R = 8;
    const mid = (x1 + x2) / 2;
    if (Math.abs(y2 - y1) < 2 * R) return `M${x1},${y1} H${x2}`;
    const dy = Math.sign(y2 - y1);
    return `M${x1},${y1} H${mid - R} Q${mid},${y1} ${mid},${y1 + dy * R} V${y2 - dy * R} Q${mid},${y2} ${mid + R},${y2} H${x2}`;
  }
  function drawArch() {
    if (!arch || !archSvg) return;
    const box = arch.getBoundingClientRect();
    archSvg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
    archSvg.replaceChildren();
    const at = (k: string) => arch.querySelector(`[data-arch-node="${k}"]`)?.getBoundingClientRect();
    const api = at('api');
    if (!api) return;
    const links: [string, boolean][] = [
      ['ext', true],
      ['web', true],
      ['db', false],
      ['ai', false],
    ];
    links.forEach(([k, into], i) => {
      const n = at(k);
      if (!n) return;
      const d = into
        ? elbow(n.right - box.left, n.top + n.height / 2 - box.top, api.left - box.left, api.top + api.height / 2 - box.top + (i === 0 ? -8 : 8))
        : elbow(api.right - box.left, api.top + api.height / 2 - box.top + (i === 2 ? -8 : 8), n.left - box.left, n.top + n.height / 2 - box.top);
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('id', `arch-${k}`);
      path.setAttribute('d', d);
      archSvg.appendChild(path);
      pulse(archSvg, `arch-${k}`, i * 0.7 + (into ? 0 : 1.2), 2.8);
    });
  }
  if (arch) new ResizeObserver(drawArch).observe(arch);
  document.fonts?.ready.then(drawArch);

  /* Things that play once when they scroll into view: the terminal types. */
  const plays = document.querySelectorAll('[data-term]');
  if ('IntersectionObserver' in window) {
    const po = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('play');
            po.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    for (const el of plays) po.observe(el);
  } else {
    for (const el of plays) el.classList.add('play');
  }

  /*
   * How it works. The track is several screens tall and its content is pinned;
   * how far through the track you are picks the step.
   */
  const how = document.querySelector<HTMLElement>('[data-how]');
  const howBar = document.querySelector<HTMLElement>('[data-how-bar]');
  const count = how ? how.querySelectorAll('[data-how-c]').length : 0;
  let current = -1;

  function updateHow() {
    if (!how || !count) return;
    const r = how.getBoundingClientRect();
    const run = r.height - window.innerHeight;
    const p = run > 0 ? Math.min(1, Math.max(0, -r.top / run)) : 0;
    const i = Math.min(count - 1, Math.floor(p * count));
    if (i === current) return;
    current = i;
    for (const el of how.querySelectorAll<HTMLElement>('[data-how-i],[data-how-p],[data-how-c]')) {
      const n = Number(el.dataset.howI ?? el.dataset.howP ?? el.dataset.howC);
      el.classList.toggle('on', n === i);
    }
    const cap = how.querySelector<HTMLElement>(`[data-how-c="${i}"]`);
    if (howBar && cap?.dataset.bar) howBar.textContent = cap.dataset.bar;
  }

  /* The dark panel opens from an inset card to the full width as it arrives. */
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  function updatePanel() {
    if (!panel || reduce) return;
    const r = panel.getBoundingClientRect();
    const vh = window.innerHeight;
    const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.7)));
    panel.style.setProperty('--open', (1 - (1 - p) ** 2).toFixed(3));
  }

  const onScroll = () =>
    requestAnimationFrame(() => {
      updateHow();
      updatePanel();
    });
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  updateHow();
  updatePanel();
</script>

