---
/*
 * Written by scripts/render-thumbs.mjs, which renders the committed template
 * PDFs to WebP. Imported rather than the filenames being assumed, so a
 * template whose picture was never rendered fails this build by name instead
 * of shipping a broken <img> nobody notices.
 */
import thumbs from '../../public/templates/thumbs/manifest.json';
import { ProductDemo } from '../components/landing/ProductDemo';
import Layout from '../layouts/Layout.astro';

/*
 * The landing page.
 *
 * Two different jobs, deliberately split:
 *
 * - The hero carries a slanted, layered stack of UI fragments with a light
 *   running its leading edge. It is decoration and is marked aria-hidden. Its
 *   job is the four seconds before someone decides to keep reading.
 * - The section below mounts the REAL ApplicationsTable against fixtures. A
 *   visitor can filter it, change a status, walk it with j/k. That component
 *   was already presentational, so nothing had to be loosened to get it here.
 *
 * Flat and straight-on for the part you interact with, slanted for the part you
 * only look at. A demo rotated 16 degrees is a poster, not a demo.
 *
 * The old version of this page hand-drew four rows in CSS and called that the
 * product, which is how it sat on emoji feature cards through an entire
 * redesign without anyone noticing it had stopped describing anything.
 */

const GITHUB_URL = 'https://github.com/brgv-code/jlog';

const steps = [
  {
    id: 'capture',
    title: 'Capture',
    body: 'Apply on LinkedIn, Wellfound, Ashby, Greenhouse, Lever or YC and the row writes itself. Anywhere else, one click reads the page.',
  },
  {
    id: 'track',
    title: 'Track',
    body: 'Home leads with what needs you today — gone quiet, awaiting a reply, mid-interview — rather than with a count.',
  },
  {
    id: 'tailor',
    title: 'Tailor',
    body: 'A CV and cover letter written for the posting in front of you, compiled to PDF from real LaTeX. Built from your history, not from a prompt.',
  },
];

/* Six boards with their own content script, named because the list is the claim. */
const BOARDS = ['LinkedIn', 'Wellfound', 'Ashby', 'Greenhouse', 'Lever', 'YC Jobs'];

/*
 * Home's charts, at plausible density.
 *
 * Fixed rather than random so the page renders identically on every build, and
 * internally consistent — the funnel, the sources and the hero's row count all
 * add up to the same 72 applications. A mock whose own numbers disagree is the
 * fastest way to tell a reader the screenshot is fiction.
 */
const WEEKLY = [1, 0, 2, 3, 1, 4, 2, 5, 3, 6, 4, 7, 5, 4, 8, 6, 9, 7, 11, 8, 12, 9, 14, 10, 13, 9];

const TREND_W = 560;
const TREND_H = 120;

/** Baseline at the bottom edge, peak 12px clear of the top. */
const trendPoints = WEEKLY.map((v, i) => {
  const x = (i / (WEEKLY.length - 1)) * TREND_W;
  const y = TREND_H - 12 - (v / Math.max(...WEEKLY)) * (TREND_H - 24);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const trendLine = trendPoints.join(' ');
const trendArea = `0,${TREND_H} ${trendLine} ${TREND_W},${TREND_H}`;

const funnel = [
  { status: 'saved', label: 'Saved', count: 11 },
  { status: 'applied', label: 'Applied', count: 34 },
  { status: 'interviewing', label: 'Interviewing', count: 9 },
  { status: 'offer', label: 'Offer', count: 2 },
  { status: 'rejected', label: 'Rejected', count: 13 },
  { status: 'withdrawn', label: 'Withdrawn', count: 3 },
];

const sources = [
  { label: 'LinkedIn', count: 26 },
  { label: 'Greenhouse', count: 14 },
  { label: 'Ashby', count: 11 },
  { label: 'Lever', count: 8 },
  { label: 'Wellfound', count: 7 },
  { label: 'Manual', count: 6 },
];

/* Fixed bins, matching the real chart: a histogram whose bins move with the
   data cannot be compared against the same chart a month later. */
const replyBuckets = [
  { label: '0-3d', count: 6 },
  { label: '3-7d', count: 11 },
  { label: '1-2w', count: 9 },
  { label: '2-4w', count: 5 },
  { label: '4w+', count: 3 },
];

/** The three states Home opens on, because each one implies an action. */
const attention = [
  { label: 'Ghosted', value: 7, hint: 'applied over 14 days ago, still silent' },
  { label: 'Awaiting response', value: 12, hint: 'recent enough that silence is normal' },
  { label: 'In interview', value: 9, hint: 'mid-process, and yours to move' },
];

/* The providers the app actually adapts to. Ollama is the point of the list. */
const providers = [
  { name: 'Anthropic', note: 'Claude' },
  { name: 'OpenAI', note: 'GPT' },
  { name: 'Gemini', note: 'Google' },
  { name: 'Ollama', note: 'local, no key, nothing leaves the machine' },
];

/*
 * The real pages, not diagrams of them.
 *
 * These used to be six abstract skeletons drawn in CSS — a name bar and some
 * repeating-gradient body text — on the reasoning that six pdf.js canvases is
 * a lot of JavaScript for a marketing page. That reasoning still holds; the
 * mistake was concluding the alternative was a drawing. `render-thumbs.mjs`
 * renders the committed PDFs to WebP once, by hand, and the page ships six
 * 18KB images of actual typeset documents. A claim about typesetting that is
 * illustrated with grey rectangles is a claim nobody has to believe.
 *
 * `note` is the one thing a picture of a first page does not say by itself.
 */
const templates: { id: keyof typeof thumbs; label: string; note: string }[] = [
  { id: 'classic', label: 'Classic', note: 'moderncv, dated left column' },
  { id: 'banking', label: 'Banking', note: 'centred rule under the name' },
  { id: 'casual', label: 'Casual', note: 'larger name, looser leading' },
  { id: 'oldstyle', label: 'Oldstyle', note: 'serif, centred headings' },
  { id: 'fancy', label: 'Fancy', note: 'filled header block' },
  { id: 'plain', label: 'Plain', note: 'single column, ATS-safe' },
];

for (const template of templates) {
  if (!thumbs[template.id]) {
    throw new Error(
      `No rendered thumbnail for the "${template.id}" template. Run scripts/render-thumbs.mjs.`,
    );
  }
}

/*
 * The pinned act.
 *
 * Five beats of one continuous gesture — posting, capture, row, document,
 * compile — scrubbed by scroll rather than played on a timer. The page already
 * made each of these claims in its own section; what it never showed was that
 * they are one motion. `label` names the beat in the rail, `caption` is the
 * line that fades in under the scene while that beat is current.
 */
const beats = [
  {
    id: 'posting',
    label: 'The posting',
    caption: 'A job page like any other. You were going to apply to it anyway.',
  },
  {
    id: 'capture',
    label: 'Captured',
    caption: 'The extension recognises the apply and reads the page. Nothing to click.',
  },
  {
    id: 'row',
    label: 'Tracked',
    caption: 'It becomes a row in the pipeline, with a status you can move.',
  },
  {
    id: 'document',
    label: 'Written',
    caption: 'A CV for this posting, composed from facts you imported once.',
  },
  {
    id: 'compiled',
    label: 'Compiled',
    caption: 'Every line traced back to its source, then typeset through real LaTeX.',
  },
];

/*
 * The thread diagram.
 *
 * Grounding is the one claim on this page nobody else can make, and it was
 * being carried by two <mark> background colours. Here each generated line is
 * drawn with a curve running back to the fact it came from and the requirement
 * it answers — teal for your CV, ochre for the posting, the same pairing the
 * app uses. `y` is the row's centre in the SVG's own coordinate space, so the
 * curves and the text cannot drift apart when the copy changes.
 */
/*
 * Rows are a fixed height so the SVG gutters can be drawn in the same
 * coordinate space as the HTML beside them: three 84px rows with 8px between
 * puts the row centres at 42, 134 and 226 of a 268-tall box, and the curves
 * land on them without anything being measured at runtime.
 */
const THREAD_ROW = 84;
const THREAD_GAP = 8;
const THREAD_H = THREAD_ROW * 3 + THREAD_GAP * 2;
/** Centre of row i, in the gutters' own coordinates. */
const threadY = (i: number) => THREAD_ROW / 2 + i * (THREAD_ROW + THREAD_GAP);

/** What you wrote, once, and had to tick before it was stored. */
const threadFacts = [
  'Owned the design system — 40 engineers, 6 product teams',
  'Cut dashboard load 3.2s → 900ms by code-splitting',
  'Specified interaction and empty states with designers',
];

/** What this posting asked for, in the order the posting asked for it. */
const threadNeeds = [
  'Work directly with designers on interaction detail',
  'Own our design system and component library',
  'Keep the app fast — performance is a feature here',
];

/*
 * The generated lines, each one the join of a fact and a requirement.
 *
 * `need` is deliberately not the identity mapping. A CV is written in your
 * order and a posting is written in theirs, so the ochre threads cross and the
 * teal ones do not — which is the actual shape of the problem, and the reason
 * a CV has to be rewritten per posting rather than reordered.
 */
const threadLines = [
  {
    fact: 0,
    need: 1,
    text: 'Owned the design system 40 engineers across 6 product teams built on.',
  },
  { fact: 1, need: 2, text: 'Cut median dashboard load from 3.2s to 900ms by code-splitting.' },
  { fact: 2, need: 0, text: 'Specified interaction and empty states with designers before build.' },
];

/**
 * A gentle S rather than a straight rule: a thread, not a table border.
 *
 * A curve between two rows at the same height has identical control points and
 * comes out dead straight, which reads as a border someone forgot to remove.
 * Those get a small sag instead, so the teal runs are visibly drawn even where
 * they connect a fact to the line directly below it.
 */
const threadPath = (from: number, to: number, width: number) => {
  const y1 = threadY(from);
  const y2 = threadY(to);
  const sag = from === to ? 9 : 0;
  return `M0,${y1} C${width * 0.42},${y1 + sag} ${width * 0.58},${y2 + sag} ${width},${y2}`;
};
---

<Layout
  title="jlog — track every application, and write a CV for each one"
  description="An open-source job tracker that captures applications from the board you're already on, then writes a CV for each posting from your real history — every line traceable to something you wrote."
>
  <div class="page">
    <!--
      Film grain. A pure-white page is optically flat, and flatness is most of
      what makes a light landing page feel like a document template rather than
      a designed surface. One inline SVG turbulence at 3% — no request, no
      raster, and it tiles at any zoom.
    -->
    <div class="grain" aria-hidden="true"></div>
    <header class="nav">
      <a href="/" class="wordmark" aria-label="jlog home">
        <svg class="wordmark-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect class="mark-ground" width="32" height="32" rx="7"></rect>
          <circle class="mark-dot" cx="20" cy="6.5" r="2.2"></circle>
          <path
            class="mark-j"
            d="M20 12.5 V19.5 A4.25 4.25 0 0 1 11.5 19.5"
            stroke-width="4"
            stroke-linecap="round"></path>
        </svg>
        <span>jlog</span>
      </a>
      <!--
        Read position, as a hairline on the nav's own bottom edge. It is the
        one piece of chrome that can say how long this page is without a number
        or a scrollbar, and it costs one element and one custom property.
      -->
      <span class="nav-progress" aria-hidden="true"></span>
      <nav class="nav-actions">
        <a href={GITHUB_URL} class="nav-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="/login" class="nav-link">Sign in</a>
        <a href="/login" class="btn btn-primary">Get started free</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Open source · Self-hostable · Bring your own model</p>
        <!--
          Split for the entrance only. Each word is its own span so they can
          resolve in sequence rather than the block fading in as one; the text
          is intact for a screen reader, a crawler, and anyone with motion
          turned off, because the spans are inert until the script opts in.
        -->
        <h1 class="headline">
          <span class="ln">
            <span class="w">Every</span> <span class="w">job</span> <span class="w">you</span>
            <span class="w">apply</span> <span class="w">to,</span> <span class="w">captured.</span>
          </span>
          <span class="ln">
            <span class="w">Every</span> <span class="w">CV</span> <span class="w">you</span>
            <span class="w">send,</span> <span class="w">written</span> <span class="w">for</span>
            <span class="w">it.</span>
          </span>
        </h1>
        <p class="subheading">
          jlog logs the application from the job board you were already on, then writes a CV for
          that posting out of your real history — every line traceable back to something you
          actually wrote.
        </p>
        <div class="cta-row">
          <a href="/login" class="btn btn-primary btn-lg">Get started free</a>
          <a href={GITHUB_URL} class="btn btn-ghost btn-lg" target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        </div>

        <!--
          Decorative, and aria-hidden: nothing here says anything the copy above
          has not. Four fragments of the app in perspective — the posting it
          reads, the pipeline it fills, the document it writes, and the compile
          that ends it — so the depth carries the sequence without a caption.

          The content is written out at real density rather than suggested with
          grey bars. A hero that abstracts the product into rectangles is a
          diagram of software; the detail is the part that reads as a real thing
          someone uses.
        -->
        <div class="stage" aria-hidden="true">
          <div class="glow"></div>
          <div class="stack">
            <!-- 1. The posting, furthest back and softest. -->
            <div class="layer layer-jd">
              <div class="bar">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="bar-url">jobs.ashbyhq.com/linear</span>
              </div>
              <div class="jd">
                <h3 class="jd-title">Senior Product Engineer</h3>
                <p class="jd-meta">Linear · Remote · Full-time</p>
                <p class="jd-p">
                  We are looking for a senior engineer to join the apps team and take ownership of
                  the surfaces our customers live in.
                </p>
                <p class="jd-h">What you'll do</p>
                <ul class="jd-list">
                  <li>Ship product surfaces end to end, from spec to release.</li>
                  <li class="jd-hit">Own our design system and component library.</li>
                  <li>Keep the app fast — performance is a feature here.</li>
                  <li>Work directly with designers on interaction detail.</li>
                </ul>
              </div>
            </div>

            <!-- 2. The pipeline. The widest panel and the centre of the composition. -->
            <div class="layer layer-list">
              <div class="bar">
                <span class="bar-title">Applications</span>
                <span class="bar-tools">
                  <span class="tab on">All</span>
                  <span class="tab">Applied</span>
                  <span class="tab">Interviewing</span>
                  <span class="search">Search company or role…</span>
                </span>
                <span class="bar-count">72</span>
              </div>
              <div class="rows">
                <div class="row">
                  <span class="mono-tile" data-h="14">S</span>
                  <span class="cell">
                    <span class="co">Stripe</span>
                    <span class="ro">Staff Frontend Engineer</span>
                  </span>
                  <span class="meta">Remote — EU · LinkedIn</span>
                  <span class="pill interviewing">Interviewing</span>
                </div>
                <div class="row row-on">
                  <span class="mono-tile" data-h="252">L</span>
                  <span class="cell">
                    <span class="co">Linear</span>
                    <span class="ro">Senior Product Engineer</span>
                  </span>
                  <span class="meta">Remote · Ashby</span>
                  <span class="pill applied">Applied</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="196">V</span>
                  <span class="cell">
                    <span class="co">Vercel</span>
                    <span class="ro">Developer Experience Engineer</span>
                  </span>
                  <span class="meta">Berlin, DE · Greenhouse</span>
                  <span class="pill offer">Offer</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="28">A</span>
                  <span class="cell">
                    <span class="co">Anthropic</span>
                    <span class="ro">Product Engineer</span>
                  </span>
                  <span class="meta">Remote — EU · Greenhouse</span>
                  <span class="pill interviewing">Interviewing</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="120">C</span>
                  <span class="cell">
                    <span class="co">Cloudflare</span>
                    <span class="ro">Systems Engineer, Workers</span>
                  </span>
                  <span class="meta">Lisbon, PT · Workday</span>
                  <span class="pill applied">Applied</span>
                </div>
                <div class="row">
                  <span class="mono-tile" data-h="320">R</span>
                  <span class="cell">
                    <span class="co">Raycast</span>
                    <span class="ro">Frontend Engineer</span>
                  </span>
                  <span class="meta">London, UK · Manual</span>
                  <span class="pill saved">Saved</span>
                </div>
              </div>
            </div>

            <!-- 3. The document, nearest and sharpest, on paper rather than UI. -->
            <div class="layer layer-cv">
              <svg class="comet" viewBox="0 0 400 260" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="cometTail" x1="0" y1="0" x2="1" y2="0">
                    <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0"></stop>
                    <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="1"></stop>
                  </linearGradient>
                </defs>
                <rect
                  x="1" y="1" width="398" height="258" rx="11"
                  fill="none" stroke="url(#cometTail)" stroke-width="2"
                  pathLength="100" stroke-dasharray="14 86" stroke-linecap="round"></rect>
              </svg>

              <div class="cv">
                <div class="cv-head">
                  <span class="cv-name">John Doe</span>
                  <span class="cv-contact">john@example.com · Berlin · github.com/jdoe</span>
                </div>
                <p class="cv-sec">Experience</p>
                <div class="cv-entry">
                  <span class="cv-when">2021 — 2025</span>
                  <span class="cv-what">
                    <span class="cv-role">Senior Frontend Engineer, Acme</span>
                    <span class="cv-b">
                      Owned the <mark class="cite cite-jd">design system</mark> that
                      <mark class="cite cite-cv">40 engineers</mark> across 6 product teams built on.
                    </span>
                    <span class="cv-b">
                      Cut median dashboard load from <mark class="cite cite-cv">3.2s to 900ms</mark>
                      by code-splitting the bundle.
                    </span>
                  </span>
                </div>
                <div class="cv-entry">
                  <span class="cv-when">2018 — 2021</span>
                  <span class="cv-what">
                    <span class="cv-role">Frontend Engineer, Northwind</span>
                    <span class="cv-b">
                      Specified interaction and empty states with designers before build.
                    </span>
                  </span>
                </div>
              </div>

              <div class="cv-key">
                <span><i class="sw sw-cv"></i>your CV</span>
                <span><i class="sw sw-jd"></i>the posting</span>
              </div>
            </div>

            <!-- 4. The extension, caught mid-capture. This is where the sequence
                 actually starts, so it sits highest and furthest right — the
                 eye enters there and travels down-left through the stack. -->
            <div class="layer layer-ext">
              <div class="ext-head">
                <span class="ext-mark">j</span>
                <span class="ext-title">Captured from Ashby</span>
              </div>
              <dl class="ext-fields">
                <div><dt>Company</dt><dd>Linear</dd></div>
                <div><dt>Role</dt><dd>Senior Product Engineer</dd></div>
                <div><dt>Location</dt><dd>Remote</dd></div>
              </dl>
              <span class="ext-cta">Save to jlog</span>
            </div>

            <!-- 5. The small one. Closest to the viewer, and the only thing moving
                 on its own, which is what makes the rest read as still rather
                 than as dead. -->
            <div class="layer layer-chip">
              <span class="ping"></span>
              <span class="chip-main">Compiled to PDF</span>
              <span class="chip-sub">tectonic · 1.8s · classic</span>
            </div>
          </div>
        </div>
      </section>

      <section class="proof reveal">
        <dl class="proof-grid stagger">
          <div><dt data-count="6">6</dt><dd>job boards captured automatically</dd></div>
          <div><dt data-count="6">6</dt><dd>CV designs, compiled from LaTeX</dd></div>
          <div><dt data-count="4">4</dt><dd>model providers, including local Ollama</dd></div>
          <div><dt>MIT</dt><dd>runs on Cloudflare's free tier</dd></div>
        </dl>
        <!--
          Three copies, and the track travels exactly one copy before it loops,
          so the wrap has no seam. Three rather than two because six board names
          do not fill a wide viewport once: at two copies the whole list stood on
          screen twice at rest, which reads as a duplicated list, not a ticker.
          aria-hidden on the copies keeps a screen reader from reading the six
          boards three times.
        -->
        <div class="marquee">
          <div class="marquee-track">
            <span class="marquee-set">
              {BOARDS.map((board) => <span class="board">{board}</span>)}
            </span>
            {[0, 1].map(() => (
              <span class="marquee-set" aria-hidden="true">
                {BOARDS.map((board) => <span class="board">{board}</span>)}
              </span>
            ))}
          </div>
        </div>
      </section>

      <section class="steps reveal">
        {
          steps.map((step) => (
            <article class="step">
              <svg class={`step-icon step-icon-${step.id}`} viewBox="0 0 24 24" aria-hidden="true">
                {step.id === 'capture' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v11" />
                    <path d="M8 10l4 4 4-4" />
                    <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
                  </g>
                )}
                {step.id === 'track' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 6h11" />
                    <path d="M9 12h11" />
                    <path d="M9 18h11" />
                    <path d="M4 6h.01" />
                    <path d="M4 12h.01" />
                    <path d="M4 18h.01" />
                  </g>
                )}
                {step.id === 'tailor' && (
                  <g fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h5" />
                    <path d="M14 3v5h5" />
                    <path d="M20 13l-5.5 5.5-2.5.6.6-2.5L18.1 11a1.3 1.3 0 0 1 1.9 1.9z" />
                  </g>
                )}
              </svg>
              <h2 class="step-title">{step.title}</h2>
              <p class="step-body">{step.body}</p>
            </article>
          ))
        }
      </section>

      <!--
        The act.

        The three claims above are the three claims this page has always made,
        and it made them as three paragraphs and, further down, as four separate
        static panels. What none of that showed is that they are one continuous
        motion — a posting you were reading becomes a row becomes a document
        without you doing anything in between.

        So this is that motion, pinned and scrubbed: the rail is tall, the stage
        sticks to the top of it, and scroll position drives the scene rather than
        scrolling past it. Everything inside is driven by six numbers the script
        writes on the stage each frame — an overall --q and one 0-to-1 progress
        per beat — so the whole choreography is CSS calc against those, and it
        runs backwards as cleanly as forwards.

        Without JS, under prefers-reduced-motion, in print, and on a phone it is
        not pinned at all: the default styles lay the five panels out as a plain
        static composition and every beat is simply visible. The pinned version
        is what `html.motion` opts into.
      -->
      <section class="act" aria-labelledby="act-title">
        <div class="act-rail">
          <div class="act-stage" data-beat="0">
            <div class="act-side">
              <div>
                <p class="eyebrow">Start to finish</p>
                <h2 class="section-title section-title-xl" id="act-title">One posting, all the way through</h2>
              </div>

              <!--
                The caption lives inside its beat rather than in a box of its
                own, so the rail stays one list and the eye never leaves it. In
                the pinned version all but the current one are collapsed to zero
                height; in the static fallback they are simply all open, which
                is the right way to read five steps you cannot scrub.
              -->
              <ol class="act-steps">
                {
                  beats.map((beat, i) => (
                    <li class="act-step" data-i={i}>
                      <span class="act-step-n">{String(i + 1).padStart(2, '0')}</span>
                      <span class="act-step-l">{beat.label}</span>
                      <span class="act-step-c">{beat.caption}</span>
                    </li>
                  ))
