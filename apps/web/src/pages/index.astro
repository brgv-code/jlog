              </ol>
            </div>

            <div class="act-frame" aria-hidden="true">
              <div class="act-scene">
                <!-- 1. The posting. On screen from the first frame; it is where
                     the story starts and it never leaves, it is only left
                     behind by the camera. -->
                <div class="act-panel act-jd">
                  <div class="bar">
                    <span class="dots"><i></i><i></i><i></i></span>
                    <span class="bar-url">jobs.ashbyhq.com/linear</span>
                  </div>
                  <div class="jd">
                    <h3 class="jd-title">Senior Product Engineer</h3>
